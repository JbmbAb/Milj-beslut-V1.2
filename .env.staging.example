# Staging non-secret configuration (PNRC I2).
# Copy to .env.staging and adjust paths. Do not commit real secrets.
#
# Secrets: prefer Docker secrets under deploy/staging/secrets/ (see secrets.example/README.md).
# .env.staging may hold bootstrap secrets for local prep only.

POSTGRES_PASSWORD=staging-change-me

# L1 application (non-secret defaults)
ADMIN_CONSOLE_USERNAME=admin
LANTMATERIET_BASE_URL=https://api.lantmateriet.se/ogc-features/v1
LANTMATERIET_OPEN_MODE=true

# Authority C — master/source archive host path
IMPORT_ARCHIVE_HOST_PATH=./storage

# Optional fail-closed CAS (authority B)
# MIMERS_REQUIRED=1
