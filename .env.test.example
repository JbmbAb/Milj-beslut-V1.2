# Test environment example
NODE_ENV=test
PORT=8787

# Auth and admin
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD=admin-test-password
ADMIN_ORG_NAME=Miljobeslut Test Org
ADMIN_ORG_NUMBER=999999-0001

# Database (docker compose --profile test-db up -d db-test)
DATABASE_URL=postgresql://miljobeslut:password@localhost:5433/miljobeslut_test?sslmode=disable
# Set true to run integration tests and include them in test:coverage:all
DATABASE_INTEGRATION=true

# DB-0-SAFETY: destructive GIS test setup (DROP EXTENSION / DROP SCHEMA / DROP TABLE) refuses
# to run unless this database is admitted twice over — once by the repository allowlist in
# tests/setup/disposableGisTestDatabase.ts, and once explicitly here. Both must name the same
# database that DATABASE_URL actually targets. Without these two lines the destructive setup
# fails closed, opening no connection and executing no SQL. That is intended: the flag is an
# assertion that this database is disposable and may be destroyed on every test run.
GIS_TEST_DB_DISPOSABLE=1
GIS_TEST_DB_NAME=miljobeslut_test

# Security integrations (mock/offline safe defaults)
LANTMATERIET_OPEN_MODE=true
LANTMATERIET_BASE_URL=https://example.invalid
BANKID_BASE_URL=https://example.invalid
BANKID_PFX_PATH=C:\\tmp\\dummy.pfx
SLU_API_BASE_URL=https://example.invalid
SLU_API_KEY=test-slu-key

# Server runtime
CORS_ALLOW_ORIGINS=http://localhost:3000
SEARCH_WORKER_ENABLED=false

# Vertex / Gemini (lokal dev + E2E)
VERTEX_PROJECT_ID=miljointelligens
# Valfritt: sätt GEMINI_API_KEY om du inte använder ADC (`gcloud auth application-default login`).
# GitHub CI sätter en dummy-nyckel automatiskt (ingen ADC på runner).

# ── Legal Reranker Custom Prompts (Minimal Prod) ─────────────────────────────
LEGAL_RERANKER_PROMPT_GCS=
LEGAL_RERANKER_PROMPT_VERSION=test-version
LEGAL_RERANKER_PROMPT_FILE=
