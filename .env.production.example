# ─────────────────────────────────────────────────────────────────────────────
# .env.production.example — lokal primär prod (docker-compose.prod.yml)
#
# Kopiera till .env.production och fyll i riktiga värden.
# .env.production är gitignored — committa aldrig hemligheter.
# GCP pilot: använd scripts/gcp/sync-secrets-from-env.ps1 för Secret Manager.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ── Databas (lokal PostGIS i compose) ─────────────────────────────────────────
DATABASE_URL=postgresql://miljobeslut:password@db:5432/miljobeslut_prod?sslmode=disable

# ── JWT (generera: openssl rand -hex 64) ──────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Vertex AI (enda obligatoriska molntjänsten) ─────────────────────────────
VERTEX_PROJECT_ID=miljointelligens
VERTEX_LOCATION=europe-west1

# ── Workers (in-process på egen server) ───────────────────────────────────────
SEARCH_WORKER_ENABLED=true
GDPR_CRON_IN_PROCESS=true
START_WORKERS_IN_PROCESS=true

# ── Observability ─────────────────────────────────────────────────────────────
QUERY_HASH_SALT=
QUERY_HASH_SALT_VERSION=v1
LEGAL_RERANKER=on
LEGAL_RERANKER_RELATIVE_GAP=0.15

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD=

# ── Sök-kryptering (32 bytes base64) ──────────────────────────────────────────
SEARCH_ENCRYPTION_KEY_BASE64=

# ── Master Archive (bind mount i docker-compose.prod.yml) ───────────────────────
# IMPORT_ARCHIVE_ROOT=/data/geo_master
# KNOWLEDGE_BASE_ROOT=/data/geo_master/knowledge_base

# ── AI (Vertex primärt; GEMINI_API_KEY som fallback lokalt) ───────────────────
# GEMINI_API_KEY=
# OPENAI_API_KEY=   # ej aktuell

# ── Lantmäteriet (OAuth2 — två nycklar) ───────────────────────────────────────
LANTMATERIET_CONSUMER_KEY=
LANTMATERIET_CONSUMER_SECRET=
LANTMATERIET_BASE_URL=https://api.lantmateriet.se/ogc-features/v1
LANTMATERIET_OPEN_MODE=false
# LANTMATERIET_SCOPE=ogc-features:fastighetsindelning.read

# ── SLU ───────────────────────────────────────────────────────────────────────
SLU_API_BASE_URL=https://api.artdatabanken.se
SLU_API_KEY=

# ── Trafikverket (valfritt — token lokalt i .env.production vid behov) ────────
# TRAFIKVERKET_API_KEY=
# TRAFIKVERKET_API_BASE_URL=https://api.trafikinfo.trafikverket.se/v2/data.json

# ── VISS ──────────────────────────────────────────────────────────────────────
VISS_API_KEY=
CORS_ALLOW_ORIGINS=http://localhost:3000

# ── Uppladdningar (lokal disk — ingen GCS bucket) ─────────────────────────────
# GCS_DOCUMENTS_BUCKET=
