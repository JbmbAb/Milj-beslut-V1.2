# ─────────────────────────────────────────────────────────────────────────────
# .env.production.example — lokal primär prod (docker-compose.prod.yml)
#
# Kopiera till .env.production och fyll i riktiga värden.
# .env.production är gitignored — committa aldrig hemligheter.
# GCP pilot: pwsh scripts/gcp/sync-secrets-from-env.ps1 -SkipDatabaseUrl
# Fas 1: pwsh scripts/ops/rotate-prod-secrets.ps1
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=8080
LOG_LEVEL=info

# Observability Fas 1 (labels + optional OTLP endpoint presence check)
#PIPELINE_VERSION=1.0.0
#REGISTRY_VERSION=1.0.0
#OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Databas — PostgreSQL projection (authority D) ─────────────────────────────
DATABASE_URL=postgresql://miljobeslut:REPLACE_WITH_SECRET@db:5432/miljobeslut_prod?sslmode=disable

# ── JWT (generera: pwsh scripts/ops/rotate-prod-secrets.ps1) ────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Vertex AI (enda obligatoriska molntjänsten) ─────────────────────────────
VERTEX_PROJECT_ID=miljointelligens
VERTEX_LOCATION=europe-west1

# ── Workers (separata processer enligt PNRC-0.1 / I2) ─────────────────────────
SEARCH_WORKER_ENABLED=true
GDPR_CRON_IN_PROCESS=true
START_WORKERS_IN_PROCESS=false
LU_PROVISIONING_WORKERS_STRICT=true

# ── Observability ─────────────────────────────────────────────────────────────
QUERY_HASH_SALT=
QUERY_HASH_SALT_VERSION=v1
LEGAL_RERANKER=on
LEGAL_RERANKER_RELATIVE_GAP=0.15

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD=

# ── Sök-kryptering (32 bytes base64) ──────────────────────────────────────────
SEARCH_ENCRYPTION_KEY_BASE64=

# ── Backup (app + pg_dump via scripts/ops/backup-prod-db.ps1) ─────────────────
BACKUP_DIR=/app/storage/backups

# ── Storage authorities (hålls separata) ──────────────────────────────────────
# A: document/object storage
DOCUMENT_STORAGE_ROOT=/app/storage/uploads
# B: canonical Mimers CAS
MIMERS_ROOT=/data/mimers
MIMERS_REQUIRED=1
MIMERS_DURABILITY_MODE=best-effort
# C: master/source archive (read-only bind mount)
IMPORT_ARCHIVE_ROOT=/data/geo_master
KNOWLEDGE_BASE_ROOT=/data/geo_master/knowledge_base
# D: PostgreSQL projection = DATABASE_URL ovan

# ── AI (Vertex primärt; GEMINI_API_KEY som fallback lokalt) ───────────────────
# GEMINI_API_KEY=
# OPENAI_API_KEY=   # ej aktuell

# ── Lantmäteriet (OAuth2 — två nycklar) ───────────────────────────────────────
LANTMATERIET_CONSUMER_KEY=
LANTMATERIET_CONSUMER_SECRET=
LANTMATERIET_BASE_URL=https://api.lantmateriet.se/ogc-features/v1
LANTMATERIET_OPEN_MODE=false
# LANTMATERIET_SCOPE=ogc-features:fastighetsindelning.read

# ── SLU ───────────────────────────────────────────────────────────────────────
SLU_API_BASE_URL=https://api.artdatabanken.se
SLU_API_KEY=

# ── Trafikverket (valfritt — token lokalt vid behov) ──────────────────────────
# TRAFIKVERKET_API_KEY=
# TRAFIKVERKET_API_BASE_URL=https://api.trafikinfo.trafikverket.se/v2/data.json

# ── VISS ──────────────────────────────────────────────────────────────────────
VISS_API_KEY=

# ── CORS (lägg till prod-domän när TLS/Caddy är klart) ────────────────────────
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# ── Uppladdningar (lokal disk — ingen GCS bucket) ─────────────────────────────
# GCS_DOCUMENTS_BUCKET=
