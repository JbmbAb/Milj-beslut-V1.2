generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

generator erd {
  provider = "prisma-erd-generator"
  output   = "../docs/architecture/er-diagram.svg"
  theme    = "forest"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core", "env", "public", "topo10"]
}

/// Core user entity. Handles authentication links (BankID) and role-based access control.
model User {
  id                           String                        @id @default(cuid())
  organisationId               String
  bankidId                     String                        @unique
  role                         UserRole
  createdAt                    DateTime                      @default(now())
  interactionPrototypeSessions InteractionPrototypeSession[]
  memberships                  ProjectMember[]
  accessLogs                   PropertyAccessLog[]
  PropertyAccessLog_legacy     PropertyAccessLog_legacy[]
  searchQueries                SearchQueryLog[]
  SearchQueryLog_legacy        SearchQueryLog_legacy[]
  organisation                 Organisation                  @relation(fields: [organisationId], references: [id])

  @@schema("public")
}

model TokenRevocation {
  id        String   @id @default(cuid())
  userId    String
  jti       String   @unique
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@schema("public")
}

model RateLimitEntry {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
  @@schema("public")
}

/// Root entity for multi-tenancy. Every user and project belongs to exactly one organisation.
model Organisation {
  id                           String                        @id @default(cuid())
  name                         String
  orgNumber                    String                        @unique
  createdAt                    DateTime                      @default(now())
  authorityInboxEvents         AuthorityInboxEvent[]
  CaseSnapshot                 CaseSnapshot[]
  documents                    DocumentRecord[]
  EvidenceExport               EvidenceExport[]
  interactionPrototypeSessions InteractionPrototypeSession[]
  permitApplicationDrafts      PermitApplicationDraft[]
  projects                     Project[]
  RequirementCase              RequirementCase[]
  submissions                  Submission[]
  users                        User[]
  cNotificationChemicals       CNotificationChemical[]

  @@schema("public")
}

/// The central container for all environmental permit work. 
/// Tracks status, compliance scores, and ties together documents, requirements, and members.
model Project {
  id                           String                        @id @default(cuid())
  organisationId               String
  propertyDesignation          String
  status                       ProjectStatus
  createdAt                    DateTime                      @default(now())
  closedAt                     DateTime?
  retentionUntil               DateTime?
  complianceScore              Float?
  environmentalScore           Float?
  fundingRating                String?
  regulatoryRiskScore          Float?
  authorityInboxEvents         AuthorityInboxEvent[]
  CaseSnapshot                 CaseSnapshot[]
  documents                    DocumentRecord[]
  EvidenceExport               EvidenceExport[]
  interactionPrototypeSessions InteractionPrototypeSession[]
  permitApplicationDrafts      PermitApplicationDraft[]
  organisation                 Organisation                  @relation(fields: [organisationId], references: [id])
  members                      ProjectMember[]
  planState                    ProjectPlanState?
  accessLogs                   PropertyAccessLog[]
  PropertyAccessLog_legacy     PropertyAccessLog_legacy[]
  requirementCases             RequirementCase[]
  requirements                 RequirementRecord[]
  searchQueries                SearchQueryLog[]
  SearchQueryLog_legacy        SearchQueryLog_legacy[]
  submissions                  Submission[]
  cNotificationChemicals       CNotificationChemical[]
  components                   ProjectComponent[]
  satelliteAnalyses            SatelliteAnalysis[]

  @@index([organisationId, status])
  @@schema("public")
}

model SatelliteScene {
  id                   String              @id @default(cuid())
  sceneId              String              @unique
  capturedAt           DateTime
  cloudCoverPercentage Float
  platform             String
  productType          String
  thumbnailUrl         String?
  bbox                 Json
  createdAt            DateTime            @default(now())
  analyses             SatelliteAnalysis[]

  @@map("satellite_scenes")
  @@schema("public")
}

/// Results of processing satellite scenes (e.g., NDVI, RGB) for a specific project.
model SatelliteAnalysis {
  id             String         @id @default(cuid())
  projectId      String         @map("project_id")
  sceneId        String         @map("scene_id")
  analysisType   String         @map("analysis_type")
  resultMetadata Json           @map("result_metadata")
  imageDiskPath  String?        @map("image_disk_path")
  observedAt     DateTime       @map("observed_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scene          SatelliteScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  @@index([projectId, analysisType])
  @@index([sceneId])
  @@map("satellite_analyses")
  @@schema("public")
}

/// C-anmälan: kemikalieförteckning (tabell skapad via migration 20260426120000)
model CNotificationChemical {
  id                      String       @id @default(cuid())
  organisationId          String       @map("organisation_id")
  projectId               String?      @map("project_id")
  name                    String
  annualConsumption       String?      @map("annual_consumption")
  storageNote             String?      @map("storage_note")
  hazardCode              String?      @map("hazard_code")
  requiresSafetyDataSheet Boolean      @default(false) @map("requires_safety_data_sheet")
  reviewStatus            String       @default("DRAFT") @map("review_status")
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")
  organisation            Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                 Project?     @relation(fields: [projectId], references: [id])

  @@index([organisationId, updatedAt])
  @@index([projectId])
  @@map("c_notification_chemicals")
  @@schema("public")
}

/// Tillståndsansökan: sparat utkast per projekt (API /api/projects/:id/permit)
model PermitApplicationDraft {
  id                  String       @id @default(cuid())
  projectId           String
  organisationId      String
  application         Json
  generatedAt         DateTime?
  sourceTracking      Json         @default("[]")
  externalSourcesUsed Json         @default("[]")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  organisation        Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project             Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, updatedAt])
  @@index([organisationId])
  @@schema("public")
}

model ProjectPlanState {
  id            String   @id @default(cuid())
  projectId     String   @unique
  schemaVersion Int      @default(2)
  plan          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@schema("public")
}

/// Junction table for project access control, defining the role of a user within a specific project.
model ProjectMember {
  id         String            @id @default(cuid())
  projectId  String
  userId     String
  accessRole ProjectAccessRole
  createdAt  DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@schema("public")
}

model PropertyAccessLog {
  id                  String                @default(cuid())
  userId              String
  projectId           String
  propertyDesignation String
  timestamp           DateTime              @default(now())
  purpose             String
  responseClass       PropertyResponseClass
  project             Project               @relation(fields: [projectId], references: [id])
  user                User                  @relation(fields: [userId], references: [id])

  @@id([id, timestamp])
  @@index([projectId, timestamp])
  @@index([userId, timestamp])
  @@index([timestamp], map: "PropertyAccessLog_timestamp_brin_idx", type: Brin)
  @@schema("public")
}

model BackgroundJob {
  id          String    @id @default(cuid())
  type        String
  status      String    @default("PENDING")
  payload     Json?
  result      Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, type])
  @@schema("public")
}

/// C-anmälan schaktmassor — canonical ärende.
model CNotificationMassCase {
  id                    String   @id
  referenceNumber       String   @unique @map("reference_number")
  organisationId        String   @map("organisation_id")
  createdByUserId       String   @map("created_by_user_id")
  projectId             String   @map("project_id")
  propertyDesignation   String   @map("property_designation")
  status                String   @default("DRAFT")
  municipalityReference String?  @map("municipality_reference")
  payload               Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@index([projectId])
  @@map("c_notification_mass_cases")
  @@schema("public")
}

/// Enskilt avlopp — canonical ärende (staging/produktion).
model SewageApplicationCase {
  id                    String   @id
  referenceNumber       String   @unique @map("reference_number")
  organisationId        String   @map("organisation_id")
  createdByUserId       String   @map("created_by_user_id")
  projectId             String?  @map("project_id")
  municipalityCode      String?  @map("municipality_code")
  pe                    Float    @default(5)
  propertyDesignation   String   @map("property_designation")
  latitude              Float
  longitude             Float
  applicantName         String   @map("applicant_name")
  applicantEmail        String   @map("applicant_email")
  systemType            String   @map("system_type")
  purpose               String?
  status                String   @default("DRAFT")
  decisionNote          String?  @map("decision_note")
  municipalityReference String?  @map("municipality_reference")
  payload               Json     @default("{}")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([organisationId])
  @@index([referenceNumber])
  @@map("sewage_application_cases")
  @@schema("public")
}

/// Immutable security log. Stores a chain of hashes to ensure data integrity and track all administrative actions.
model AuditTrail {
  id              String   @default(cuid())
  entityType      String
  entityId        String
  action          String
  userId          String?
  timestamp       DateTime @default(now())
  payloadHash     String
  prevHash        String?
  chainHash       String
  referenceNumber String?  @map("reference_number")

  @@id([id, timestamp])
  @@index([referenceNumber])
  @@index([entityType, timestamp])
  @@index([timestamp], map: "AuditTrail_timestamp_brin_idx", type: Brin)
  @@schema("public")
}

/// Represents a waste transport order. Tracks logistics from origin to receiver, including CO2 estimates and regulatory status.
model TransportBooking {
  id                 String               @id @default(cuid())
  quoteId            String
  provider           String
  status             String
  receiverId         String
  receiverName       String
  wasteCode          String
  tons               Float
  distanceKm         Float
  co2EstimateKg      Float
  plannedPickupAt    DateTime
  plannedDeliveryAt  DateTime
  externalReference  String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  journals           DriverJournal[]
  gpsPositions       GpsPosition[]
  GpsPosition_legacy GpsPosition_legacy[]
  limsReports        LimsReport[]

  @@index([status])
  @@index([receiverId])
  @@schema("public")
}

model DriverJournal {
  id                  String           @id @default(cuid())
  bookingId           String
  driverName          String
  vehicleId           String
  origin              String
  destination         String
  wasteCode           String
  tons                Float
  startedAt           DateTime
  endedAt             DateTime?
  odometerStartKm     Float
  odometerEndKm       Float?
  gpsTrackHash        String?
  status              String           @default("DRAFT")
  signedByDriver      Boolean          @default(false)
  signedByReviewer    Boolean          @default(false)
  driverSignatureId   String?
  reviewerSignatureId String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  booking             TransportBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([driverName])
  @@index([status])
  @@schema("public")
}

/// Lab analysis results (Laboratory Information Management System). Tied to waste bookings for compliance verification.
model LimsReport {
  id                  String            @id @default(cuid())
  bookingId           String?
  sampleId            String
  labName             String
  source              String            @default("MANUAL")
  analyzedAt          DateTime
  rawReference        String
  metrics             Json
  passed              Boolean
  verifiedByHuman     Boolean           @default(false)
  reviewer            String?
  reviewerSignatureId String?
  verifiedAt          DateTime?
  createdAt           DateTime          @default(now())
  booking             TransportBooking? @relation(fields: [bookingId], references: [id])

  @@index([sampleId])
  @@schema("public")
}

/// High-frequency GPS tracking points for transport vehicles. Used for geo-fencing and route validation.
model GpsPosition {
  id        String           @default(cuid())
  bookingId String
  lat       Float
  lng       Float
  altitude  Float?
  speedKmh  Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime         @default(now())
  hash      String
  prevHash  String?
  booking   TransportBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@id([id, timestamp])
  @@index([bookingId, timestamp])
  @@index([timestamp], map: "GpsPosition_timestamp_brin_idx", type: Brin)
  @@schema("public")
}

/// Metadata for an uploaded or ingested document. Tracks processing status, AI-extracted field confidence, and ownership. This is the main entry point for document-related workflows.
model DocumentRecord {
  id                     String                         @id @default(cuid())
  projectId              String
  organisationId         String
  entryId                String
  receivedTime           DateTime?
  subject                String
  originalName           String
  diskName               String                         @unique
  absolutePath           String
  fileSize               BigInt?
  fileSha256             String?
  mimeType               String?
  status                 DocumentProcessingStatus       @default(METADATA_ONLY)
  decisionType           String?
  municipality           String?
  wasteType              String?
  hazardousFlag          Boolean?
  legalStatus            String?
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  manifestMeta           Json?
  activityCode           String?
  activityCodeConfidence Float?
  activityCodeSource     String?
  decisionTypeConfidence Float?
  decisionTypeSource     String?
  diarieConfidence       Float?
  diarieSource           String?
  fieldExtractorVersion  Json?
  metadataReviewStatus   String                         @default("AUTO")
  municipalityConfidence Float?
  municipalityNormalized String?
  municipalityRaw        String?
  municipalitySource     String?
  wasteTypeConfidence    Float?
  wasteTypeSource        String?
  authorityInboxEvents   AuthorityInboxEvent[]
  classifications        ClassificationRecommendation[]
  chunks                 DocumentChunk[]
  content                DocumentContent?
  metadataEvidence       DocumentMetadataEvidence[]
  organisation           Organisation                   @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  project                Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewQueue            MetadataReviewQueue[]
  requirementCase        RequirementCase?
  requirementCitations   RequirementCitation[]
  RequirementMatrixRow   RequirementMatrixRow[]
  requirements           RequirementRecord[]
  submissionArtifacts    SubmissionArtifact[]
  OutlookAttachment      OutlookAttachment[]
  decision_cases         decision_cases[]
  decision_requirements  decision_requirements[]

  @@index([projectId, receivedTime])
  @@index([organisationId, receivedTime])
  @@index([status, updatedAt])
  @@index([municipalityNormalized, decisionType])
  @@index([metadataReviewStatus, updatedAt])
  @@index([legalStatus])
  @@schema("public")
}

/// Sensitive text content extracted from documents. Stored encrypted at rest with per-document IVs. Used as the primary source for semantic search and LLM context.
model DocumentContent {
  id                String         @id @default(cuid())
  documentId        String         @unique
  contentCiphertext String
  contentIv         String
  contentTag        String
  keyVersion        Int            @default(1)
  searchText        String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  document          DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// Granular text segments used for vector-based semantic search (RAG). Each chunk is indexed with an embedding for fast retrieval.
model DocumentChunk {
  id            String         @id @default(cuid())
  documentId    String
  chunkIndex    Int
  chunkText     String
  embeddingJson Json?
  createdAt     DateTime       @default(now())
  document      DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@schema("public")
}

model SearchJob {
  id         String          @id @default(cuid())
  type       SearchJobType
  status     SearchJobStatus @default(PENDING)
  projectId  String?
  payload    Json
  error      String?
  attempts   Int             @default(0)
  createdAt  DateTime        @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
  @@index([type, status])
  @@schema("public")
}

/// Audit log for all AI and lexical searches. Stores parameters and performance metrics for relevance tuning.
model SearchQueryLog {
  id          String     @default(cuid())
  userId      String
  projectId   String
  query       String
  mode        SearchMode @default(hybrid)
  topK        Int        @default(20)
  resultCount Int        @default(0)
  elapsedMs   Int        @default(0)
  createdAt   DateTime   @default(now())
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id])

  @@id([id, createdAt])
  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt], map: "SearchQueryLog_createdAt_brin_idx", type: Brin)
  @@schema("public")
}

/// A specific legal case (e.g., a permit decision) that has been parsed into individual requirements.
model RequirementCase {
  id                           String                         @id @default(cuid())
  caseKey                      String                         @unique
  projectId                    String
  documentId                   String                         @unique
  organisationId               String
  municipality                 String?
  authorityType                String?
  authorityName                String?
  diarienummer                 String?
  documentType                 String?
  documentDate                 DateTime?
  sourceFile                   String
  sourceSubject                String?
  reviewStatus                 RequirementVerificationStatus  @default(AUTO)
  validatedBy                  String?
  validatedAt                  DateTime?
  notes                        String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime                       @updatedAt
  caseReviewStatus             String                         @default("AUTO")
  authorityInboxEvents         AuthorityInboxEvent[]
  CaseSnapshot                 CaseSnapshot[]
  ClassificationRecommendation ClassificationRecommendation[]
  EvidenceExport               EvidenceExport[]
  document                     DocumentRecord                 @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organisation                 Organisation                   @relation(fields: [organisationId], references: [id])
  project                      Project                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations                    RequirementCitation[]
  RequirementMatrixRow         RequirementMatrixRow[]
  requirements                 RequirementRecord[]
  submissions                  Submission[]
  CaseNote                     CaseNote[]
  decision_cases               decision_cases[]

  @@index([projectId, documentDate])
  @@index([municipality, authorityType])
  @@schema("public")
}

/// An individual legal requirement (villkor) extracted from a decision. Includes deadlines, categories, and verification status.
model RequirementRecord {
  id                     String                        @id @default(cuid())
  requirementCode        String                        @unique
  caseId                 String
  documentId             String
  projectId              String
  sourceType             String
  category               String
  subcategory            String
  requirementTextQuote   String
  interpretedRequirement String
  level                  String
  legalReference         String?
  deadlineText           String?
  controlFrequency       String?
  sanctionText           String?
  triggerCondition       String?
  wasteType              String?
  ewcCode                String?
  maxAmountTon           String?
  maxStorageTime         String?
  linkConstruction       Boolean                       @default(false)
  linkLeachate           Boolean                       @default(false)
  linkControlProgram     Boolean                       @default(false)
  linkRisk               Boolean                       @default(false)
  templateSection        String?
  templateField          String?
  supportingAttachment   String?
  minimumRequirement     Boolean                       @default(false)
  municipalitySpecific   Boolean                       @default(false)
  statusInNotification   String                        @default("Ej behandlad")
  comment                String?
  codingConfidence       String                        @default("LOW")
  verifiedBy             String?
  verifiedAt             DateTime?
  errorType              String?
  validationComment      String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  requirementHash        String?
  verificationStatus     RequirementVerificationStatus @default(AUTO)
  citations              RequirementCitation[]
  RequirementMatrixRow   RequirementMatrixRow[]
  case                   RequirementCase               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document               DocumentRecord                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project                Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@index([requirementHash])
  @@index([projectId, category])
  @@schema("public")
}

/// Direct text evidence (citations) from the source document that supports a specific requirement.
model RequirementCitation {
  id                 String                        @id @default(cuid())
  citationCode       String                        @unique
  requirementId      String
  caseId             String
  documentId         String
  quoteText          String
  pageNumber         Int?
  charStart          Int?
  charEnd            Int?
  extractor          String?
  verifiedBy         String?
  verifiedAt         DateTime?
  comment            String?
  createdAt          DateTime                      @default(now())
  verificationStatus RequirementVerificationStatus @default(AUTO)
  case               RequirementCase               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document           DocumentRecord                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requirement        RequirementRecord             @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  matrixRows         RequirementMatrixRow[]

  @@index([documentId, pageNumber])
  @@index([requirementId])
  @@schema("public")
}

model EmailMessage {
  messageId   String                 @id @map("message_id")
  sender      String?
  subject     String?
  receivedAt  DateTime?              @map("received_at")
  processedAt DateTime?              @map("processed_at")
  status      String                 @default("NEW")
  runId       String?                @map("run_id")
  rawEmlPath  String?                @map("raw_eml_path")
  occurrences AttachmentOccurrence[]
  attachments OutlookAttachment[]    @relation("CanonicalMessage")
  run         PipelineRun?           @relation(fields: [runId], references: [runId])

  @@map("email_messages")
  @@schema("public")
}

model OutlookAttachment {
  attachmentHash     String                 @id @map("attachment_hash")
  canonicalMessageId String                 @map("canonical_message_id")
  filename           String
  filesize           BigInt?
  checksumSha256     String                 @map("checksum_sha256")
  storedPath         String?                @map("stored_path")
  parsed             Boolean                @default(false)
  documentId         String?                @map("document_id")
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @default(now()) @updatedAt @map("updated_at")
  extractedText      String?                @map("extracted_text")
  parseFailureReason String?                @map("parse_failure_reason")
  occurrences        AttachmentOccurrence[]
  canonicalMessage   EmailMessage           @relation("CanonicalMessage", fields: [canonicalMessageId], references: [messageId])
  document           DocumentRecord?        @relation(fields: [documentId], references: [id])
  requirements       ExtractedRequirement[]

  @@index([parsed])
  @@index([documentId])
  @@index([documentId], map: "idx_attachments_document")
  @@index([parsed], map: "idx_attachments_parsed")
  @@map("attachments")
  @@schema("public")
}

model AttachmentOccurrence {
  messageId      String            @map("message_id")
  attachmentHash String            @map("attachment_hash")
  firstSeenAt    DateTime          @default(now()) @map("first_seen_at")
  attachment     OutlookAttachment @relation(fields: [attachmentHash], references: [attachmentHash])
  message        EmailMessage      @relation(fields: [messageId], references: [messageId])

  @@id([messageId, attachmentHash])
  @@map("attachment_occurrences")
  @@schema("public")
}

model PipelineRun {
  runId          String         @id @map("run_id")
  runType        String         @map("run_type")
  stageName      String?        @map("stage_name")
  startedAt      DateTime       @default(now()) @map("started_at")
  finishedAt     DateTime?      @map("finished_at")
  status         String         @default("RUNNING")
  processedCount Int            @default(0) @map("processed_count")
  errorCount     Int            @default(0) @map("error_count")
  configSnapshot Json?          @map("config_snapshot")
  notes          String?
  EmailMessage   EmailMessage[]

  @@map("ingest_runs")
  @@schema("public")
}

model ExtractedRequirement {
  id               String            @id @default(cuid())
  attachmentHash   String            @map("attachment_hash")
  municipality     String?
  caseNumber       String?           @map("case_number")
  requirementText  String            @map("requirement_text")
  category         String
  subcategory      String?
  requirementLevel String            @default("mandatory") @map("requirement_level")
  legalReference   String?           @map("legal_reference")
  confidence       Float             @default(0.0)
  pageNumber       Int?              @map("page_number")
  sourceSegment    String?           @map("source_segment")
  parsedAt         DateTime          @default(now()) @map("parsed_at")
  attachment       OutlookAttachment @relation(fields: [attachmentHash], references: [attachmentHash], onDelete: Cascade)

  @@index([attachmentHash])
