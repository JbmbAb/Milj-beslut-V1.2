  model             String   @default("gemini-3.5-flash")
  purpose           String   @default("INTERACTIONS_PROTOTYPE")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id])
  organisation Organisation @relation(fields: [organisationId], references: [id])
  project      Project?     @relation(fields: [projectId], references: [id])

  @@index([userId, createdAt])
  @@index([organisationId])
  @@index([projectId])
  @@schema("public")
}

model HarvestBatch {
  id                    String               @id @default(uuid())
  provider              String
  dataset               String
  harvested_at          DateTime             @default(now())
  source_url            String?
  source_archive_sha256 String?
  content_bundle_sha256 String
  status                String
  importBatches         PostgisImportBatch[]

  @@schema("public")
}

model PostgisImportBatch {
  id               String       @id @default(uuid())
  harvest_batch_id String
  target_schema    String
  target_table     String
  imported_at      DateTime     @default(now())
  row_count        Int?
  dataset_version  String?
  harvestBatch     HarvestBatch @relation(fields: [harvest_batch_id], references: [id])

  @@schema("public")
}
