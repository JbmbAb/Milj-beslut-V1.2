generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  CONSULTANT
  AUDITOR
  BANK
}

enum ProjectStatus {
  ACTIVE
  CLOSED
  ARCHIVED
  COMPLETED
  DRAFT
}


enum ProjectAccessRole {
  OWNER
  CONTRIBUTOR
  REVIEWER
  AUDITOR
}

enum PropertyResponseClass {
  geometry
  boundaries
  ownership_redacted
}

enum DocumentProcessingStatus {
  METADATA_ONLY
  TEXT_EXTRACTED
  CHUNKED
  EMBEDDED
  FAILED
}

enum SearchJobType {
  SYNC_MANIFEST
  EXTRACT_TEXT
  EMBED_DOC
}

enum SearchJobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

enum SearchMode {
  semantic
  lexical
  hybrid
}

enum RequirementVerificationStatus {
  AUTO
  NEEDS_REVIEW
  REVIEWED
  VERIFIED
  REJECTED
  LOCKED
}

model User {
  id             String          @id @default(cuid())
  organisationId String
  bankidId       String          @unique
  role           UserRole
  createdAt      DateTime        @default(now())
  organisation   Organisation    @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  memberships    ProjectMember[]
  accessLogs     PropertyAccessLog[]
  searchQueries  SearchQueryLog[]
}

model TokenRevocation {
  id        String   @id @default(cuid())
  userId    String
  jti       String   @unique
  revokedAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model RateLimitEntry {
  id      String   @id @default(cuid())
  key     String   @unique
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

model Organisation {
  id           String           @id @default(cuid())
  name         String
  orgNumber    String           @unique
  role         OrganizationRole @default(CLIENT)
  updatedAt    DateTime         @default(now()) @updatedAt
  contactEmail String?
  phone        String?
  address      Json?
  createdAt    DateTime         @default(now())
  users        User[]
  projects     Project[]
  documents    DocumentRecord[]
}

enum OrganizationRole {
  CLIENT
  AUTHORITY
  CONTRACTOR
  PARTNER
}

model Project {
  id                  String              @id @default(cuid())
  organisationId      String
  propertyDesignation String
  status              ProjectStatus
  createdAt           DateTime            @default(now())
  closedAt            DateTime?
  retentionUntil      DateTime?
  organisation        Organisation        @relation(fields: [organisationId], references: [id], onDelete: Restrict)
  members             ProjectMember[]
  accessLogs          PropertyAccessLog[]
  documents           DocumentRecord[]
  searchQueries       SearchQueryLog[]
  requirementCases    RequirementCase[]
  requirements        RequirementRecord[]
  planState           ProjectPlanState?
  complianceScore     Float?
  fundingRating       String?
  regulatoryRiskScore Float?
  environmentalScore  Float?
  @@index([organisationId, status])
}

model ProjectPlanState {
  id            String   @id @default(cuid())
  projectId     String   @unique
  schemaVersion Int      @default(2)
  plan          Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
}

model ProjectMember {
  id         String            @id @default(cuid())
  projectId  String
  userId     String
  accessRole ProjectAccessRole
  createdAt  DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([projectId, userId])
}

model PropertyAccessLog {
  id                  String                @id @default(cuid())
  userId              String
  projectId           String
  propertyDesignation String
  timestamp           DateTime              @default(now())
  purpose             String
  responseClass       PropertyResponseClass
  user                User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  project             Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  @@index([projectId, timestamp])
  @@index([userId, timestamp])
}

model AuditTrail {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String
  userId      String?
  timestamp   DateTime @default(now())
  payloadHash String
  prevHash    String?
  chainHash   String   @unique
  @@index([entityType, timestamp])
}

model TransportBooking {
  id                String   @id @default(cuid())
  quoteId           String
  provider          String
  status            String
  receiverId        String
  receiverName      String
  wasteCode         String
  tons              Float
  distanceKm        Float
  co2EstimateKg     Float
  plannedPickupAt   DateTime
  plannedDeliveryAt DateTime
  externalReference String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  journals          DriverJournal[]
  limsReports       LimsReport[]
  gpsPositions      GpsPosition[]

  @@index([status])
  @@index([receiverId])
}

model DriverJournal {
  id                  String   @id @default(cuid())
  bookingId           String
  driverName          String
  vehicleId           String
  origin              String
  destination         String
  wasteCode           String
  tons                Float
  startedAt           DateTime
  endedAt             DateTime?
  odometerStartKm     Float
  odometerEndKm       Float?
  gpsTrackHash        String?
  status              String   @default("DRAFT")
  signedByDriver      Boolean  @default(false)
  signedByReviewer    Boolean  @default(false)
  driverSignatureId   String?
  reviewerSignatureId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  booking             TransportBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([driverName])
  @@index([status])
}

model LimsReport {
  id                 String   @id @default(cuid())
  bookingId          String?
  sampleId           String
  labName            String
  source             String   @default("MANUAL")
  analyzedAt         DateTime
  rawReference       String
  metrics            Json     // Storing as JSON for flexibility in dev
  passed             Boolean
  verifiedByHuman    Boolean  @default(false)
  reviewer           String?
  reviewerSignatureId String?
  verifiedAt         DateTime?
  createdAt          DateTime @default(now())
  booking            TransportBooking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([sampleId])
}

model GpsPosition {
  id        String   @id @default(cuid())
  bookingId String
  lat       Float
  lng       Float
  altitude  Float?
  speedKmh  Float?
  heading   Float?
  accuracy  Float?
  timestamp DateTime @default(now())
  hash      String
  prevHash  String?
  booking   TransportBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId, timestamp])
}

model DocumentRecord {
  id                        String                   @id @default(cuid())
  projectId                 String
  organisationId            String
  entryId                   String
  receivedTime              DateTime?
  subject                   String
  originalName              String
  diskName                  String                   @unique
  absolutePath              String
  fileSize                  BigInt?
  fileSha256                String?
  mimeType                  String?
  status                    DocumentProcessingStatus @default(METADATA_ONLY)
  // Legacy field kept for compatibility – normalised value preferred
  municipality              String?
  municipalityRaw           String?
  municipalityNormalized    String?
  municipalityConfidence    Float?
  municipalitySource        String?
  decisionType              String?
  decisionTypeConfidence    Float?
  decisionTypeSource        String?
  activityCode              String?
  activityCodeConfidence    Float?
  activityCodeSource        String?
  wasteType                 String?
  wasteTypeConfidence       Float?
  wasteTypeSource           String?
  hazardousFlag             Boolean?
  legalStatus               String?
  diarieConfidence          Float?
  diarieSource              String?
  metadataReviewStatus      String                   @default("AUTO")
  fieldExtractorVersion     Json?
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  manifestMeta              Json?
  project                   Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organisation              Organisation             @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  content                   DocumentContent?
  chunks                    DocumentChunk[]
  requirementCase           RequirementCase?
  requirements              RequirementRecord[]
  requirementCitations      RequirementCitation[]
  metadataEvidence          DocumentMetadataEvidence[]
  reviewQueue               MetadataReviewQueue[]
  matrixRows                    RequirementMatrixRow[]
  attachments                   OutlookAttachment[]
  classificationRecommendations ClassificationRecommendation[]
  humanApprovalGates           HumanApprovalGate[]

  @@index([projectId, receivedTime])
  @@index([organisationId, receivedTime])
  @@index([status, updatedAt])
  @@index([municipalityNormalized, decisionType])
  @@index([metadataReviewStatus, updatedAt])
  @@index([legalStatus])
}

model DocumentContent {
  id                String         @id @default(cuid())
  documentId        String         @unique
  contentCiphertext String
  contentIv         String
  contentTag        String
  keyVersion        Int            @default(1)
  searchText        String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  document          DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model DocumentChunk {
  id                  String           @id @default(cuid())
  documentId          String
  chunkIndex          Int
  chunkText           String           @db.Text
  embeddingJson       Json?
  createdAt           DateTime         @default(now())
  document            DocumentRecord   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // New relationship for extracted relational values
  extractedLimits     KravParametrar[]

  // Checkpointing flag
  parametersExtracted Boolean          @default(false) @map("parameters_extracted")

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model KravParametrar {
  id                 String             @id @default(cuid())
  chunkId            String             @map("chunk_id")
  chunk              DocumentChunk      @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  
  parameterTyp       ParameterType      @map("parameter_typ")
  gransvarde         Float              @map("gransvarde")
  enhet              ParameterUnit      @map("enhet")
  comparisonOperator ComparisonOperator @map("comparison_operator")
  
  // Traceability & Auditing
  sourceText         String?            @map("source_text") @db.Text
  charStart          Int?               @map("char_start")
  charEnd            Int?               @map("char_end")
  confidence         Float?             @map("confidence")
  pageNumber         Int?               @map("page_number")
  originalValue      String?            @map("original_value")
  
  // Metadata
  extractedBy        String             @default("gemini-pipeline") @map("extracted_by")
  modelVersion       String             @map("model_version")
  promptVersion      String             @map("prompt_version")
  processedAt        DateTime           @default(now()) @map("processed_at")

  @@unique([chunkId, parameterTyp, gransvarde, enhet, comparisonOperator])
  @@index([parameterTyp, gransvarde])
  @@map("krav_parametrar")
}

enum ParameterType {
  PFAS_4
  PFAS_11
  BLY
  ZINK
  KOBOLT
  KADMIUM
  ARSENIK
  KOPPAR
  NICKEL
  KROM
  KVICKSILVER
  BENS_A_PYREN
  PAH_H
  PAH_M
  PAH_L
  OLJA
  TOC
  VOLYM_SCHAKT
  MELLANLAGRING_VOLYM
  MELLANLAGRING_TID
  BULLER
}

enum ComparisonOperator {
  LT
  LTE
  GT
  GTE
  EQ
  BETWEEN
}

enum ParameterUnit {
  UG_L
  MG_KG_TS
  TON
  DBA
  MANADER
  AR
  M3
}

model SearchJob {
  id         String          @id @default(cuid())
  type       SearchJobType
  status     SearchJobStatus @default(PENDING)
  projectId  String?
  payload    Json
  error      String?
  attempts   Int             @default(0)
  createdAt  DateTime        @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
  @@index([type, status])
}

model SearchQueryLog {
  id          String     @id @default(cuid())
  userId      String
  projectId   String
  query       String
  mode        SearchMode @default(hybrid)
  topK        Int        @default(20)
  resultCount Int        @default(0)
  elapsedMs   Int        @default(0)
  createdAt   DateTime   @default(now())
  user        User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
}

model RequirementCase {
  id                String              @id @default(cuid())
  caseKey           String              @unique
  projectId         String
  documentId        String              @unique
  organisationId    String
  municipality      String?
  authorityType     String?
  authorityName     String?
  diarienummer      String?
  documentType      String?
  documentDate      DateTime?
  sourceFile        String
  sourceSubject     String?
  reviewStatus      RequirementVerificationStatus @default(AUTO)
  caseReviewStatus  String              @default("AUTO") // AUTO | NEEDS_REVIEW | VERIFIED | LOCKED
  validatedBy       String?
  validatedAt       DateTime?
  notes             String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  project           Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document          DocumentRecord      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  requirements                  RequirementRecord[]
  citations                     RequirementCitation[]
  matrixRows                    RequirementMatrixRow[]
  classificationRecommendations ClassificationRecommendation[]
  humanApprovalGates           HumanApprovalGate[]

  @@index([projectId, documentDate])
  @@index([municipality, authorityType])
}

model RequirementRecord {
  id                     String                        @id @default(cuid())
  requirementCode        String                        @unique
  requirementHash        String?
  caseId                 String
  documentId             String
  projectId              String
  sourceType             String
  category               String
  subcategory            String
  requirementTextQuote   String
  interpretedRequirement String
  level                  String
  legalReference         String?
  deadlineText           String?
  controlFrequency       String?
  sanctionText           String?
  triggerCondition       String?
  wasteType              String?
  ewcCode                String?
  maxAmountTon           String?
  maxStorageTime         String?
  linkConstruction       Boolean                       @default(false)
  linkLeachate           Boolean                       @default(false)
  linkControlProgram     Boolean                       @default(false)
  linkRisk               Boolean                       @default(false)
  templateSection        String?
  templateField          String?
  supportingAttachment   String?
  minimumRequirement     Boolean                       @default(false)
  municipalitySpecific   Boolean                       @default(false)
  statusInNotification   String                        @default("Ej behandlad")
  comment                String?
  codingConfidence       String                        @default("LOW")
  verificationStatus     RequirementVerificationStatus @default(AUTO)
  verifiedBy             String?
  verifiedAt             DateTime?
  errorType              String?
  validationComment      String?
  createdAt              DateTime                      @default(now())
  updatedAt              DateTime                      @updatedAt
  case                   RequirementCase               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document               DocumentRecord                @relation(fields: [documentId], references: [id], onDelete: Cascade)
  project                Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  citations              RequirementCitation[]
  matrixRows             RequirementMatrixRow[]

  @@index([documentId])
  @@index([requirementHash])
  @@index([projectId, category])
}

model RequirementCitation {
  id                  String            @id @default(cuid())
  citationCode        String            @unique
  requirementId       String
  caseId              String
  documentId          String
  quoteText           String
  pageNumber          Int?
  charStart           Int?
  charEnd             Int?
  extractor           String?
  verificationStatus  RequirementVerificationStatus @default(AUTO)
  verifiedBy          String?
  verifiedAt          DateTime?
  comment             String?
  createdAt           DateTime          @default(now())
  requirement         RequirementRecord @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  case                RequirementCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document            DocumentRecord    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  matrixRows          RequirementMatrixRow[]

  @@index([documentId, pageNumber])
  @@index([requirementId])
}

// ═══════════════════════════════════════════════════════════
// IDEMPOTENT OUTLOOK INGESTION PIPELINE
// ═══════════════════════════════════════════════════════════

/// Tracks every ingested Outlook message. message_id is the unique Outlook Message-ID header.
model EmailMessage {
  messageId       String             @id @map("message_id")
  sender          String?
  subject         String?
  receivedAt      DateTime?          @map("received_at")
  processedAt     DateTime?          @map("processed_at")
  status          String             @default("NEW")
  runId           String?            @map("run_id")
  rawEmlPath      String?            @map("raw_eml_path")
  
  attachments     OutlookAttachment[] @relation("CanonicalMessage")
  occurrences     AttachmentOccurrence[]
  
  @@map("email_messages")
}

model OutlookAttachment {
  attachmentHash     String               @id @map("attachment_hash")
  canonicalMessageId String               @map("canonical_message_id")
  filename           String
  filesize           BigInt?
  checksumSha256     String               @map("checksum_sha256")
  storedPath         String?              @map("stored_path")
  parsed             Boolean              @default(false)
  extractedText      String?              @map("extracted_text")
  parseFailureReason String?              @map("parse_failure_reason")
  documentId         String?              @map("document_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @default(now()) @updatedAt @map("updated_at")

  canonicalMessage   EmailMessage         @relation("CanonicalMessage", fields: [canonicalMessageId], references: [messageId])
  occurrences        AttachmentOccurrence[]
  requirements       ExtractedRequirement[]
  document           DocumentRecord?      @relation(fields: [documentId], references: [id])
  
  @@index([parsed])
  @@index([documentId])
  @@map("attachments")
}

model AttachmentOccurrence {
  messageId       String               @map("message_id")
  attachmentHash  String               @map("attachment_hash")
  firstSeenAt     DateTime             @default(now()) @map("first_seen_at")

  message         EmailMessage         @relation(fields: [messageId], references: [messageId])
  attachment      OutlookAttachment    @relation(fields: [attachmentHash], references: [attachmentHash])

  @@id([messageId, attachmentHash])
  @@map("attachment_occurrences")
}

model PipelineRun {
  runId          String    @id @map("run_id")
  runType        String    @map("run_type")
  stageName      String?   @map("stage_name")
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  status         String    @default("RUNNING") // RUNNING | SUCCESS | FAILED
  processedCount Int       @default(0) @map("processed_count")
  errorCount     Int       @default(0) @map("error_count")
  configSnapshot Json?     @map("config_snapshot")
  notes          String?   @db.Text

  @@map("ingest_runs")
}

// ═══════════════════════════════════════════════════════════
// REQUIREMENT EXTRACTION
// ═══════════════════════════════════════════════════════════

/// A single extracted requirement from a PDF document.
model ExtractedRequirement {
  id               String   @id @default(cuid())
  attachmentHash   String   @map("attachment_hash")
  attachment       OutlookAttachment @relation(fields: [attachmentHash], references: [attachmentHash])
  municipality     String?
  caseNumber       String?  @map("case_number")
  requirementText  String   @map("requirement_text") @db.Text
  category         String
  subcategory      String?
  requirementLevel String   @default("mandatory") @map("requirement_level")
  legalReference   String?  @map("legal_reference")
  confidence       Float    @default(0.0)
  pageNumber       Int?     @map("page_number")
  sourceSegment    String?  @map("source_segment") @db.Text
  parsedAt         DateTime @default(now()) @map("parsed_at")
  knowledgeNodeId  String?  @map("knowledge_node_id")

  @@index([attachmentHash])
  @@index([municipality, category])
  @@index([category, requirementLevel])
  @@map("extracted_requirements")
}

// ═══════════════════════════════════════════════════════════
// KNOWLEDGE GRAPH
// ═══════════════════════════════════════════════════════════

enum KnowledgeNodeType {
  MUNICIPALITY
  CASE
  ACTIVITY
  WASTE_CODE
  REQUIREMENT
  RISK
  LEGAL_RULE
  TECHNICAL_MEASURE
  RESTRICTION
}

/// A node in the knowledge graph.
model KnowledgeNode {
  id          String            @id @default(cuid())
  nodeType    KnowledgeNodeType @map("node_type")
  name        String
  metadata    Json              @default("{}")
  outEdges    KnowledgeEdge[]   @relation("SourceEdges")
  inEdges     KnowledgeEdge[]   @relation("TargetEdges")
  createdAt   DateTime          @default(now())

  @@unique([nodeType, name])
  @@index([nodeType])
  @@map("knowledge_nodes")
}

/// A directed typed edge between two knowledge graph nodes.
model KnowledgeEdge {
  id           String        @id @default(cuid())
  sourceId     String        @map("source_id")
  targetId     String        @map("target_id")
  relation     String        // e.g. "requires", "generates", "motivates", "handles"
  weight       Float         @default(1.0)
  metadata     Json          @default("{}")
  source       KnowledgeNode @relation("SourceEdges", fields: [sourceId], references: [id])
  target       KnowledgeNode @relation("TargetEdges", fields: [targetId], references: [id])
  createdAt    DateTime      @default(now())

  @@unique([sourceId, targetId, relation])
  @@index([sourceId, relation])
  @@index([targetId, relation])
  @@map("knowledge_edges")
}

// ═══════════════════════════════════════════════════════════
// METADATA EVIDENCE & REVIEW PIPELINE
// ═══════════════════════════════════════════════════════════

/// Append-only ledger of every field extraction attempt.
model DocumentMetadataEvidence {
  id               String         @id @default(cuid())
  documentId       String
  fieldName        String         // 'municipality' | 'legalStatus' | 'decisionType' | 'activityCode' | 'wasteType'
  fieldValue       String?
  confidence       Float
  sourceType       String         // 'subject_regex' | 'filename_regex' | 'text_regex' | 'llm_inference' | 'manual'
  extractorVersion String         @default("1.0")
  rawEvidence      String?
  llmPromptHash    String?
  llmResponse      String?        @db.Text
  modelName        String?
  createdAt        DateTime       @default(now())
  document         DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, fieldName, createdAt])
}

/// Queue for low-confidence or conflicting field values requiring human review.
model MetadataReviewQueue {
  id            String         @id @default(cuid())
  documentId    String
  queueType     String         // 'LOW_CONFIDENCE' | 'DISAGREEMENT'
  fieldName     String
  proposedValue String?
  confidence    Float?
  reason        String?
  status        String         @default("OPEN") // 'OPEN' | 'APPROVED' | 'REJECTED' | 'RESOLVED'
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime       @default(now())
  document      DocumentRecord @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, queueType, createdAt])
  @@index([documentId])
}

// ═══════════════════════════════════════════════════════════
// CASE CANDIDATE STAGING
// ═══════════════════════════════════════════════════════════

/// Staging table for grouping documents into case candidates before materialization.
/// caseConfidence formula (locked):
///   diarieMatch: 0.45, diarieUnique bonus: +0.15, entryIdMatch: 0.25,
///   subjectDate: 0.20, municipalityConsistency: 0.10  → clamped [0,1]
model CaseCandidate {
  id             String   @id @default(cuid())
  caseKey        String   @unique
  documentIds    Json     @default("[]")
  entryIds       Json     @default("[]")
  municipality   String?
  diarie         String?
  decisionType   String?
  activityCode   String?
  wasteType      String?
  caseConfidence Float    @default(0)
  reasoning      Json     @default("{}")
  status         String   @default("CANDIDATE") // 'CANDIDATE' | 'MATERIALIZED' | 'REJECTED'
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, caseConfidence])
  @@index([diarie])
}

// ═══════════════════════════════════════════════════════════
// CASE NOTES
// ═══════════════════════════════════════════════════════════

/// Notes attached to a case (project) by handlers.
model CaseNote {
  id        String   @id @default(cuid())
  caseId    String   @map("case_id")
  text      String
  author    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([caseId, createdAt])
  @@map("case_notes")
}

model SatelliteScene {
  id                   String              @id @default(cuid())
  sceneId              String              @unique @map("scene_id")
  capturedAt           DateTime            @map("captured_at")
  cloudCoverPercentage Float               @map("cloud_cover_percentage")
  platform             String
  productType          String              @map("product_type")
  thumbnailUrl         String?             @map("thumbnail_url")
  bbox                 Json
  analyses             SatelliteAnalysis[]
  createdAt            DateTime            @default(now()) @map("created_at")

  @@map("satellite_scenes")
}

model SatelliteAnalysis {
  id             String         @id @default(cuid())
  projectId      String         @map("project_id")
  sceneId        String         @map("scene_id")
  scene          SatelliteScene @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  analysisType   String         @map("analysis_type")
  resultMetadata Json           @map("result_metadata")
  observedAt     DateTime       @map("observed_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@map("satellite_analyses")
}

enum LegalStorageTarget {
  PRISMA
  POSTGIS
  FILESYSTEM
  REVIEW_QUEUE
}

model JudgmentRecord {
  id            String   @id @default(cuid())
  guid          String   @unique
  title         String
  link          String
  description   String?
  pubDate       DateTime
  sourceFeed    String   @default("DOMSTOL_RSS") @map("sourceFeed")
  legalArea     String?  @default("miljo") @map("legalArea")
  authorityName String?  @map("authorityName")
  authorityType String?  @map("authorityType")
  createdAt     DateTime @default(now()) @map("createdAt")
  updatedAt     DateTime @updatedAt @map("updatedAt")

  legalCorpusRecords LegalCorpusRecord[]
  legalSourceRecords LegalSourceRecord[]

  @@map("judgment_records")
}

model LegalSourceRecord {
  id              String             @id @default(cuid())
  sourceSystem    String
  sourceType      String
  externalId      String
  title           String
  summary         String?
  sourceUrl       String
  normalizedUrl   String?
  providerId      String?
  providerLabel   String?
  authorityName   String?
  authorityType   String?
  municipality    String?
  diarienummer    String?
  legalArea       String?
  mimeType        String?
  formatHint      String?
  decisionDate    DateTime?
  publishedAt     DateTime?
  storageTarget   LegalStorageTarget
  postgisSchema   String?
  postgisTable    String?
  matrixCategory  String?
  matrixSuggested Boolean            @default(false)
  payload         Json               @default("{}")
  judgmentId      String?            @map("judgment_id")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  judgment JudgmentRecord? @relation(fields: [judgmentId], references: [id], onDelete: SetNull)
  legalCorpusRecords LegalCorpusRecord[]
  matrixRow RequirementMatrixRow?

  @@unique([sourceSystem, externalId])
  @@map("legal_source_records")
}

model LegalCorpusRecord {
  id            String    @id @default(cuid())
  recordKey     String    @unique @map("record_key")
  canonicalKey  String    @map("canonical_key")
  sourceFamily  String    @map("source_family")
  sourceType    String    @map("source_type")
  sourceSystem  String    @map("source_system")
  externalId    String?   @map("external_id")
  title         String
  summary       String?
  authorityName String?   @map("authority_name")
  authorityType String?   @map("authority_type")
  court         String?
  courtLevel    String?   @map("court_level")
  municipality  String?
  legalArea     String?   @map("legal_area")
  language      String    @default("sv")
  mimeType      String?   @map("mime_type")
  formatHint    String?   @map("format_hint")
  sourceUrl     String?   @map("source_url")
  normalizedUrl String?   @map("normalized_url")
  sourcePath    String    @map("source_path")
  publishedAt   DateTime? @map("published_at")
  decisionDate  DateTime? @map("decision_date")
  year          Int?
  caseNumber    String?   @map("case_number")
  documentText  String?   @map("document_text")
  searchText    String    @map("search_text")
  metadata      Json      @default("{}")
  tags          Json      @default("[]")
  contentHash   String?   @map("content_hash")
  byteSize      Int?      @map("byte_size")
  judgmentId    String?   @map("judgment_id")
  legalSourceId String?   @map("legal_source_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  searchVector Unsupported("tsvector")? @map("search_vector")

  judgment    JudgmentRecord?    @relation(fields: [judgmentId], references: [id], onDelete: SetNull)
  legalSource LegalSourceRecord? @relation(fields: [legalSourceId], references: [id], onDelete: SetNull)
  chunks      LegalCorpusChunk[]

  @@index([canonicalKey])
  @@index([sourceFamily, sourceType, publishedAt])
  @@index([sourceSystem, externalId])
  @@index([authorityType, legalArea, publishedAt])
  @@index([courtLevel, decisionDate])
  @@index([judgmentId])
  @@index([legalSourceId])
  @@map("legal_corpus_records")
}

model LegalCorpusChunk {
  id              String                       @id @default(cuid())
  recordId        String                       @map("record_id")
  chunkIndex      Int                          @map("chunk_index")
  chunkText       String                       @map("chunk_text") @db.Text
  chunkVersion    String                       @default("v2.2") @map("chunk_version")
  documentType    String                       @default("other") @map("document_type")
  lawName         String?                      @map("law_name")
  chapter         String?
  paragraph       String?
  section         String?
  embeddingVector Unsupported("vector")?       @map("embedding_vector")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  record LegalCorpusRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([recordId, chunkIndex, chunkVersion])
  @@index([recordId])
  @@index([chapter, paragraph])
  @@index([chunkVersion])
  @@map("legal_corpus_chunks")
}

model RequirementMatrixRow {
  id              String                        @id @default(cuid())
  requirementId   String?                       @map("requirement_id")
  citationId      String?                       @map("citation_id")
  caseId          String?                       @map("case_id")
  documentId      String?                       @map("document_id")
  category        String
  ruleText        String
  sourceText      String?
  reviewStatus    RequirementVerificationStatus @default(AUTO)
  reviewedBy      String?
  reviewedAt      DateTime?
  comments        String?
  isAutoSuggested Boolean                       @default(true)
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt
  legalSourceId   String?                       @unique @map("legal_source_id")

  requirement     RequirementRecord?            @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  citation        RequirementCitation?          @relation(fields: [citationId], references: [id], onDelete: SetNull)
  case            RequirementCase?              @relation(fields: [caseId], references: [id], onDelete: SetNull)
  document        DocumentRecord?               @relation(fields: [documentId], references: [id], onDelete: SetNull)
  legalSource     LegalSourceRecord?            @relation(fields: [legalSourceId], references: [id], onDelete: SetNull)

  @@index([caseId, category])
  @@index([legalSourceId])
  @@index([reviewStatus])
  @@map("RequirementMatrixRow")
}

model PostgisImportBatch {
  id                    String    @id @default(dbgenerated("gen_random_uuid()::text"))
  harvest_batch_id      String?   @map("harvest_batch_id")
  target_schema         String    @map("target_schema")
  target_table          String    @map("target_table")
  imported_at           DateTime  @default(now()) @map("imported_at")
  row_count             Int?      @map("row_count")
  dataset_version       String?   @map("dataset_version")
  status                String    @default("PLANNED")
  manifest_path         String?   @map("manifest_path")
  content_bundle_sha256 String    @default("") @map("content_bundle_sha256")
  source_runtime_path   String?   @map("source_runtime_path")
  ogr2ogr_version       String?   @map("ogr2ogr_version")
  started_at            DateTime  @default(now()) @map("started_at")
  completed_at          DateTime? @map("completed_at")
  error_message         String?   @map("error_message")
  import_mode           String    @default("plan") @map("import_mode")

  @@map("PostgisImportBatch")
}

model BankIdSession {
  id            String   @id @default(cuid())
  orderRef      String   @unique
  nonce         String
  ipAddress     String
  status        String   @default("PENDING")
  bankidId      String?
  signatureHash String?  @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  expiresAt     DateTime

  @@index([orderRef])
  @@index([expiresAt])
  @@map("BankIdSession")
}

enum ClassificationStatus {
  SUGGESTED
  REVIEWING
  APPROVED
  REJECTED
  APPLIED
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}

model ClassificationRecommendation {
  id                    String               @id @default(cuid())
  caseId                String               @map("case_id")
  documentId            String               @map("document_id")
  sourceDocumentHash    String               @map("source_document_hash")
  status                ClassificationStatus @default(SUGGESTED)
  aiClassification      String               @map("ai_classification")
  aiConfidence          ConfidenceLevel      @map("ai_confidence")
  aiReasoning           String?              @map("ai_reasoning") @db.Text
  sourceTextSegment     String               @map("source_text_segment") @db.Text
  charStart             Int?                 @map("char_start")
  charEnd               Int?                 @map("char_end")
  suggestedConditions   String?              @map("suggested_conditions") @db.Text
  suggestedRequirements String?              @map("suggested_requirements") @db.Text
  reviewedBy            String?              @map("reviewed_by")
  reviewedAt            DateTime?            @map("reviewed_at")
  reviewNotes           String?              @map("review_notes") @db.Text
  reviewDecision        String?              @map("review_decision")
  appliedWithChanges    Boolean              @default(false) @map("applied_with_changes")
  appliedChangesNotes   String?              @map("applied_changes_notes") @db.Text
  appliedAt             DateTime?            @map("applied_at")
  appliedBy             String?              @map("applied_by")
  createdAt             DateTime             @default(now()) @map("created_at")
  updatedAt             DateTime             @updatedAt @map("updated_at")

  case                  RequirementCase      @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document              DocumentRecord       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approvalLogs          ApprovalLog[]

  @@index([caseId])
  @@index([documentId])
  @@map("classification_recommendations")
}

model ApprovalLog {
  id                             String                       @id @default(cuid())
  classificationRecommendationId String                       @map("classification_recommendation_id")
  action                         String
  actor                          String
  reason                         String?                      @db.Text
  timestamp                      DateTime                     @default(now())
  createdAt                      DateTime                     @default(now()) @map("created_at")

  recommendation                 ClassificationRecommendation @relation(fields: [classificationRecommendationId], references: [id], onDelete: Cascade)

  @@index([classificationRecommendationId])
  @@map("approval_logs")
}

model HumanApprovalGate {
  id          String    @id @default(cuid())
  caseId      String    @map("case_id")
  documentId  String    @map("document_id")
  isOpen      Boolean   @default(true) @map("is_open")
  lockedBy    String?   @map("locked_by")
  lockedAt    DateTime? @map("locked_at")
  finalizedAt DateTime? @map("finalized_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  case        RequirementCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  document    DocumentRecord  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([caseId, documentId], name: "caseId_documentId")
  @@map("human_approval_gates")
}

model RasterRegistrationLog {
  id            Int      @id @default(autoincrement())
  provider      String
  dataset       String
  version       String
  filePath      String   @unique @map("file_path")
  sha256        String?
  sizeBytes     BigInt?  @map("size_bytes")
  epsgCode      Int?     @default(3006) @map("epsg_code")
  tileSize      String?  @default("256x256") @map("tile_size")
  tableRef      String   @map("table_ref")
  bboxWkt       String?  @map("bbox_wkt")
  bandCount     Int?     @map("band_count")
  pixelWidth    Float?   @map("pixel_width")
  pixelHeight   Float?   @map("pixel_height")
  tileCount     Int?     @map("tile_count")
  registeredAt  DateTime @default(now()) @map("registered_at") @db.Timestamptz
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("raster_registration_log")
}
