# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── Object storage (prod: GCS) ───────────────────────────────────────────────
# Utan GCS_DOCUMENTS_BUCKET lagras uploads under ./storage (dev). På Cloud Run ska bucket sättas.
#GCS_DOCUMENTS_BUCKET=your-project-documents
#GCS_DOCUMENTS_PREFIX=documents

# ── Import/archive paths (local/source-of-truth on external disk) ─────────────
# KNOWLEDGE_BASE_ROOT styr var legal/open-source corpus laddas ner och läses från.
# IMPORT_ARCHIVE_ROOT är permanent arkiv för importerat källmaterial.
# IMPORT_SOURCE_ROOT är extern källa för re-import (t.ex. shapefiles, zipfiler).
# IMPORT_CACHE_ROOT används bara som temporär arbetsyta när ett verktyg måste skriva lokalt.
# IMPORT_REIMPORT_SCAN_ROOTS kan vara semikolon- eller komma-separerad lista.
#KNOWLEDGE_BASE_ROOT=D:\MiljoBeslut_Archive\knowledge_base
#IMPORT_ARCHIVE_ROOT=D:\MiljoBeslut_Archive
#IMPORT_SOURCE_ROOT=D:\MiljoBeslut_Produktdata_Source_Files
#IMPORT_CACHE_ROOT=C:\path\to\Miljöbeslut.se\storage\import-cache
#IMPORT_REIMPORT_SCAN_ROOTS=D:\MiljoBeslut_Archive;D:\MiljoBeslut_ExternDisk;D:\MiljoBeslut_Produktdata_Source_Files

# Bakgrund: in-process (default) eller Cloud Scheduler mot /api/internal/background/*
#SEARCH_WORKER_ENABLED=true
#GDPR_CRON_IN_PROCESS=true
#INTERNAL_CRON_TOKEN=  # header X-Internal-Token för interna cron-endpoints

# ── AI / LLM — Vertex AI (enda AI-leverantör fr.o.m. spår 10b) ───────────────
# Minimikrav för "redo": VERTEX_PROJECT_ID + aktiverat Vertex i GCP-projektet.
# Autentisering: lokalt oftast `gcloud auth application-default login` (inga GOOGLE_* i .env då);
# moln: Cloud Run / GKE workload identity eller GOOGLE_APPLICATION_CREDENTIALS(_JSON) om ni kör så.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=europe-west1
# Default-modell för text-generering. Gemini 1.5 Pro för kvalitativa uppgifter.
VERTEX_TEXT_MODEL=gemini-1.5-pro
# Snabbmodell (lägre kostnad, lägre kvalitet) för fast-profile-anrop.
VERTEX_FAST_MODEL=gemini-1.5-flash
# Modell för JSON-mode-anrop (strict schema). Kan vara samma som text-modell.
VERTEX_JSON_MODEL=gemini-1.5-pro
# Text embedding (RAG / semantisk sökning) — Vertex :predict, inte Consumer API.
VERTEX_EMBEDDING_MODEL=text-multilingual-embedding-002
# Valfri lista om primär modell inte finns i region: kommaseparerade modell-id.
# VERTEX_EMBEDDING_FALLBACK_MODELS=text-embedding-005,gemini-embedding-001
# Core-flöde (krav / tillståndsutkast / verifiering) — prioriterade env-namn:
VERTEX_CORE_REQUIREMENTS_MODEL=
VERTEX_CORE_PERMIT_MODEL=
VERTEX_CORE_VERIFICATION_MODEL=
# OCR / multimodal (PDF & bild) — om utelämnat används VERTEX_FAST_MODEL / VERTEX_TEXT_MODEL.
VERTEX_OCR_MODEL=
VERTEX_OCR_MODEL_PRO=
# Valfri explicit service account (låt annars SDK använda ADC / metadata):
GOOGLE_APPLICATION_CREDENTIALS=
# Alternativt: injicera hela JSON-nyckeln (t.ex. Secret Manager → env).
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Avvecklade: Consumer API-nycklar (GEMINI_API_KEY m.m.) används inte längre för denna app.
GEMINI_DB_API_KEY=
GEMINI_DB_ALLOW_REMOTE=false

# ── Interactions API prototype (Gemini API — NOT production Vertex) ───────────
# Isolerad pilot enligt docs/architecture/INTERACTIONS_API_PROTOTYPE_PLAN_v2.md
# Endast dev/staging. Route mountas aldrig i NODE_ENV=production.
INTERACTIONS_PROTOTYPE_ENABLED=false
INTERACTIONS_GEMINI_API_KEY=
INTERACTIONS_MODEL=gemini-3.5-flash
INTERACTIONS_STORE=true
# Bakåtkompabilitet — mappas i kod till samma Vertex-modeller som VERTEX_CORE_* ovan:
# Core_GEMINI_REQUIREMENTS_MODEL, Core_GEMINI_PERMIT_MODEL, Core_VERIFICATION_MODEL
# MVP_GEMINI_REQUIREMENTS_MODEL, MVP_GEMINI_PERMIT_MODEL, MVP_OPENAI_VERIFICATION_MODEL
OCR_MODEL=
OCR_ENDPOINT=
OCR_API_KEY=

# ── Figma ─────────────────────────────────────────────────────────────────────
FIGMA_TOKEN=
FIGMA_FILE_ID=
FIGMA_MAKE_URL=

# ── Frontend (Vite) — valfri lokal grundkarta ─────────────────────────────────
# Exponeras till klienten. Använd när du hostar egen Topo10/raster som XYZ eller WMS.
# Ange antingen VITE_LOCAL_BASEMAP_XYZ_URL ELLER (WMS-URL + lager) — inte båda.
# Kommentar/attribution visas för tile-lager; WMS enligt Leaflet standard.
VITE_LOCAL_BASEMAP_LABEL=Lokal grundkarta
VITE_LOCAL_BASEMAP_ATTRIBUTION=
VITE_LOCAL_BASEMAP_XYZ_URL=
VITE_LOCAL_BASEMAP_WMS_URL=
VITE_LOCAL_BASEMAP_WMS_LAYERS=
# Endast admin på inloggningssidan (döljer BankID i UI). Starta om Vite efter ändring.
# Påverkar inte serverns /api/auth/bankid/* (signering i andra vyer m.m. ligger kvar).
# VITE_LOGIN_ADMIN_ONLY=true
# VITE_HIDE_LEGACY_PERMIT_PORTAL=true
# (Lantmäteriet karta) Vite plockar automatiskt samma värde som LANTMATERIET_OPEN_SUBSCRIPTION_KEY
# — du behöver alltså INTE också VITE_LANTMATERIET_OPEN_SUBSCRIPTION_KEY (se nedan) om båda ska vara lika.

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Används av orgInvitationService för inbjudningstokens
JWT_SECRET=

# ── Lantmäteriet API ─────────────────────────────────────────────────────────
# Välj ETT autentiseringsalternativ:
#   Alt 1 — OAuth2 Consumer (rekommenderas)
LANTMATERIET_CONSUMER_KEY=
LANTMATERIET_CONSUMER_SECRET=
LANTMATERIET_TOKEN_URL=https://apimanager.lantmateriet.se/oauth2/token
LANTMATERIET_SCOPE=
#   Alt 2 — Kortlivad direkttoken från dev-portalen (GET TEST KEY)
LANTMATERIET_ACCESS_TOKEN=
#   Alt 3 — Legacy API-nyckel
LANTMATERIET_API_KEY=
# Öppet kartläge utan autentisering (true = ingen nyckel krävs)
LANTMATERIET_OPEN_MODE=false
# LANTMATERIET_DEMO_MODE är avvecklat i 2026-04 — demo-flödet togs bort
# eftersom endast BankID får köras i mock/demo. Fastighetsuppslag kräver
# riktiga credentials för att svara.
#
# ── Avgiftsfria Lantmäteriet-tjänster ─────────────────────────────────────────
# Prenumerationsnyckel från Lantmäteriets API-portal (https://apimanager.lantmateriet.se)
# Räcker för alla nedanstående öppna produkter — de kräver registrering men
# är gratis att använda.
# Sätt ENDAST denna: vite.config mappar den till kartan (Topo/Ortofoto) utan dubbletter.
LANTMATERIET_OPEN_SUBSCRIPTION_KEY=
# Valfri override enbart om webbläsaren av någon anledning ska ha *annat* värde än servern:
# VITE_LANTMATERIET_OPEN_SUBSCRIPTION_KEY=
#
# Endpoints per produkt (override endast vid behov — defaultvärden i koden
# pekar på api.lantmateriet.se).
LANTMATERIET_OPEN_FASTIGHET_URL=https://api.lantmateriet.se/ogc-features/v1/fastighetsindelning
LANTMATERIET_OPEN_ADRESS_URL=https://api.lantmateriet.se/ogc-features/v1/belagenhetsadress
LANTMATERIET_OPEN_ORTNAMN_URL=https://api.lantmateriet.se/ogc-features/v1/ortnamn
LANTMATERIET_OPEN_ADMIN_URL=https://api.lantmateriet.se/ogc-features/v1/administrativindelning
LANTMATERIET_OPEN_TOPOWEBB_URL=https://api.lantmateriet.se/open/topowebb-ccby/v1/wmts
LANTMATERIET_OPEN_ORTOFOTO_URL=https://api.lantmateriet.se/open/ortofoto-ccby/v1/wms
LANTMATERIET_OPEN_TERRANG_URL=https://api.lantmateriet.se/open/terrangskuggning/v1/wms
# Bulk-downloads (Atom feed + FTP): ingen nyckel krävs.
LANTMATERIET_OPEN_HOJD_ATOM_URL=https://download-opendata.lantmateriet.se/
LANTMATERIET_OPEN_HOJDGRID_ATOM=https://download-opendata.lantmateriet.se/
#
LANTMATERIET_OPEN_WMS_URL=https://minkarta.lantmateriet.se/map/topowebb/?
# Lookup mode: "legacy" (distribution/produkter...) or "ogc" (recommended for fastighetsindelning)
LANTMATERIET_LOOKUP_MODE=ogc
# OGC base URL + collection för fastighetsuppslag by etikett
LANTMATERIET_BASE_URL=https://api.lantmateriet.se/ogc-features/v1
LANTMATERIET_OGC_COLLECTION=registerenhetsomradesytor
# Valfri explicit lookup-endpoint när LANTMATERIET_LOOKUP_MODE=legacy
LANTMATERIET_LOOKUP_ENDPOINT=

# ── BankID RP API (valfritt — aktivera först när avtal + certifikat finns) ───
# Före avtal: lämna dessa tomma och använd admininloggning eller BANKID_MOCK_MODE=true lokalt.
# Testmiljö kan t.ex. använda: https://appapi2.test.bankid.com/rp/v6.0
# Produktion kan t.ex. använda: https://appapi2.bankid.com/rp/v6.0
# BANKID_BASE_URL=
# BANKID_PFX_PATH=
# BANKID_PFX_PASSPHRASE=
# # Alternative PEM setup instead of PFX:
# BANKID_CERT_PATH=
# BANKID_KEY_PATH=
# BANKID_CA_PATH=

# SLU Artdatabanken API
SLU_API_BASE_URL=https://api.artdatabanken.se
SLU_API_KEY=
SLU_SPECIES_OBS_API_KEY=
SLU_TAXONOMY_API_KEY=
SLU_ARTFAKTA_API_KEY=
SLU_METODKATALOG_API_KEY=
SLU_SPECIES_OBS_BASE_PATH=/species-observation-system/v1/Observations/Search
SLU_TAXONOMY_BASE_PATH=/taxonlistservice/v1
SLU_ARTFAKTA_BASE_PATH=/information/v1/speciesdataservice/v1
SLU_METODKATALOG_BASE_PATH=/metodkatalog/v1

# ── Prisma / Databas ──────────────────────────────────────────────────────────
# SSL Configuration:
#   Production  → Use ?sslmode=require (enforces TLS encryption)
#   Development → Use ?sslmode=prefer (tries SSL, falls back to unencrypted)
#   Testing     → ?sslmode=prefer or ?sslmode=disable (disable if local unsecured DB)
#
# Connection Pool (auto-configured based on NODE_ENV):
#   Production  → max 15 connections, 10s connect timeout, 15s idle timeout
#   Development → max 5 connections, 10s connect timeout
#
# SSL certificate location (for mTLS to remote DBs, optional):
#   ssl_cert=/path/to/client-cert.pem&ssl_key=/path/to/client-key.pem&ssl_root_cert=/path/to/ca.pem
DATABASE_URL=postgresql://miljobeslut:password@localhost:5432/miljobeslut?sslmode=prefer
# Force SSL even in dev environment:
# DATABASE_SSL=true
CORS_ALLOW_ORIGINS=http://localhost:5173,https://www.figma.com

# ── RAA / K-samsök (kulturarvsdata) — valfri bas-URL; standard är kulturarvsdata.se
# KSAMSOK_API_BASE_URL=https://kulturarvsdata.se/ksamsok/api

# ── SGU (Geologiska undersökningen) ──────────────────────────────────────────
# "sample" = exempeldata, "complete" = full databas (kräver nedladdning)
SGU_DB_COVERAGE_MODE=sample

# ── Geodata / Terrän ──────────────────────────────────────────────────────────
# Extern höjddata-API (valfritt, syntetisk terräng används om den saknas)
TERRAIN_ENDPOINT=
# Land-Use / Land-Cover endpoint (valfritt)
LULC_ENDPOINT=

# ── Sök / Indexering ─────────────────────────────────────────────────────────
# Lokalt Outlook-export (exempel: D:\Users\jimmy\Desktop\OutlookExport)
OUTLOOK_BASE_DIR=
OUTLOOK_MANIFEST_PATH=
OUTLOOK_FOLDER_PATH=
OUTLOOK_STORAGE_ROOT=
OUTLOOK_INGEST_INTERVAL_MS=60000
OUTLOOK_WEBHOOK_SECRET=

# ── Outlook (Microsoft Graph) — kräver app-registrering med Mail.Read ─────────
OUTLOOK_GRAPH_TENANT_ID=
OUTLOOK_GRAPH_CLIENT_ID=
OUTLOOK_GRAPH_CLIENT_SECRET=
OUTLOOK_GRAPH_USER=
OUTLOOK_GRAPH_FOLDER=Inbox
OUTLOOK_GRAPH_FETCH_LIMIT=25

# ── Juridikingest (domstols-RSS) ─────────────────────────────────────────────
# DOMSTOL_RSS_ENABLED kan sättas till "false" för att stänga av scheduler
DOMSTOL_RSS_ENABLED=true
DOMSTOL_RSS_INTERVAL_MS=14400000
LOCAL_DB_ROOT=
MUNICIPAL_CONTACTS_CSV_PATH=
MUNICIPAL_DIARIES_INDEX_URL=
SEARCH_ENCRYPTION_KEY_BASE64=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_FALLBACK_MODELS=gemini-embedding-001,text-embedding-004
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_MS=25000
GEMINI_OCR_MODEL=gemini-2.5-flash
SEARCH_OCR_MIN_TEXT_CHARS=120
SEARCH_OCR_MAX_FILE_BYTES=12000000
SEARCH_WORKER_ENABLED=true
SEARCH_WORKER_POLL_MS=2500
SEARCH_WORKER_MAX_JOBS=3
SEARCH_JOB_MAX_ATTEMPTS=3
SEARCH_JOB_STALE_MINUTES=30
SEARCH_JOB_STALE_RECOVERY_LIMIT=200
SEARCH_JOB_RECOVERY_INTERVAL_MS=120000

# ── Tillståndsmyndigheter (myndighets-API) ────────────────────────────────────
# Endpoint för elektronisk ärendeinlämning (valfritt, mock-läge annars)
AUTHORITY_SUBMIT_ENDPOINT=
AUTHORITY_API_KEY=
AUTHORITY_BEARER_TOKEN=
AUTHORITY_SUBMIT_AUTH_MODE=
AUTHORITY_SUBMIT_TIMEOUT_MS=10000
AUTHORITY_SUBMIT_MAX_RETRIES=1
# Aktivera mock-submit för E2E-tester utan riktig myndighetsintegration.
# Mocket är avsiktligt spärrat i NODE_ENV=production.
AUTHORITY_MOCK_MODE=false

# ── Property lookup ───────────────────────────────────────────────────────────
# Läge: "hybrid" (PostGIS → öppen OGC → betalt live), "postgis", eller "live"
PROPERTY_LOOKUP_MODE=hybrid

# ── eIDAS QTSP-signatur ────────────────────────────────────────────────────────
# Qualified Trust Service Provider för kvalificerad e-signatur (valfritt)
EIDAS_QTSP_ENDPOINT=
EIDAS_QTSP_API_KEY=

# ── LIMS (Laboratoriedata) ────────────────────────────────────────────────────
# Automatisk hämtning av provresultat via HTTP eller SFTP (valfritt)
LIMS_API_ENDPOINT=
LIMS_API_KEY=
LIMS_SFTP_HOST=
LIMS_SFTP_PORT=22
LIMS_SFTP_USER=
LIMS_SFTP_PASSWORD=
LIMS_SFTP_PRIVATE_KEY_PATH=
LIMS_SFTP_PATH=

# ── Marknadsdata / Logistik ────────────────────────────────────────────────────
# Extern pristabell-API (valfritt, statiska baspriser används annars)
MARKET_INTEL_ENDPOINT=

# ── Monitorering / Felspårning ────────────────────────────────────────────────
# Sentry DSN för produktion (valfritt, lokal ring-buffer används annars)
SENTRY_DSN=
# Bearer-token för /metrics-endpoint (valfritt, öppen om den saknas)
METRICS_BEARER_TOKEN=

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_DIR=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/

# ── Admin console ────────────────────────────────────────────────────────────
# Tillsvidare: admin/admin för lokal livetest & demo. Byt till starkt lösenord före skarp drift.
# Används av servern när du loggar in som admin i webben (npm run dev → http://localhost:3000).
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD=admin
ADMIN_ORG_NAME=Miljobeslut Admin
ADMIN_ORG_NUMBER=999999-0001

# Dispatch provider feature flag
# Allowed values: MOCK_FRAKTBORS | TIMOCOM | TRANS_EU
DISPATCH_PROVIDER_MODE=MOCK_FRAKTBORS
# Optional credentials for external adapters (mock fallback if missing)
TIMOCOM_API_KEY=
TRANS_EU_API_KEY=

# Trafikverket API
TRAFIKVERKET_API_KEY=
TRAFIKVERKET_API_BASE_URL=https://api.trafikinfo.trafikverket.se/v2/data.json

# Lastkajen 2 (Trafikverket datapaket – kräver konto, ingen anonym nedladdning)
LASTKAJEN_API_BASE_URL=https://lastkajen.trafikverket.se
LASTKAJEN_USERNAME=
LASTKAJEN_PASSWORD=

# ── Lokala geodata-raster (GDAL gdallocationinfo) ───────────────────────────
# SGU jordartsgenskaper – grovt nationellt rutnät (~10 km). Standard: storage/ingest/...
#SGU_JORDART_RASTER_DIR=storage/ingest/sgu/jordart-raster/Tiff_jordartskartor
#GDAL_BIN_PATH=C:\Program Files\GDAL

# VISS WFS / vattenforekomster
# Importscriptet anvander explicit api key och har ingen anonym fallback.
VISS_API_KEY=
VISS_API_BASE_URL=https://viss.lansstyrelsen.se/api
VISS_WFS_URL=https://ext-geodata.lansstyrelsen.se/viss/wfs
VISS_LAYER_NAME=ms:viss_vattendirektivet_ytvatten
VISS_TIMEOUT_SECONDS=180

# ── Databas-statistik tröskelvärden (valfritt, standardvärden används annars)
# Kravrader ≥ 41 000, kommuner ≥ 260, dokument ≥ 3 000
DB_STATS_MIN_REQUIREMENTS=41000
DB_STATS_MIN_MUNICIPALITIES=260
DB_STATS_MIN_DOCUMENTS=3000

# ── E-postaviseringar (valfritt) ──────────────────────────────────────────────
# Om SMTP_HOST, SMTP_USER och SMTP_PASS är satta skickas notiser via e-post.
# Lämnas tomma loggas notiser endast i AuditTrail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=noreply@miljobeslut.se

# ── Legal Reranker Custom Prompts (Minimal Prod) ─────────────────────────────
# GCS URI to load custom prompt template from (e.g., gs://my-bucket/prompts/best_prompt.txt)
LEGAL_RERANKER_PROMPT_GCS=
# Version identifier for caching / logging (e.g., opt-prompt-d900aa00)
LEGAL_RERANKER_PROMPT_VERSION=default
# Local file path fallback for testing/CI (e.g., config/best_prompt.txt)
LEGAL_RERANKER_PROMPT_FILE=
