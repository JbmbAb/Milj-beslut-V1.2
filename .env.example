# ══════════════════════════════════════════════════════════
# Miljöbeslut.se – Miljövariabler (.env.example)
# Kopiera den här filen till .env och fyll i värden
# DELA ALDRIG .env-filen i versionshantering
# ══════════════════════════════════════════════════════════

# ─── ALTERNATIV 1: Lokal PostgreSQL via Docker ──────────────
# Används med: docker-compose up
DATABASE_URL=postgresql://miljobeslut:password@localhost:5432/miljobeslut

# ─── ALTERNATIV 2: Supabase Cloud ──────────────────────────
# Hämta från: Supabase Dashboard → Project Settings → Database → Connection string (URI)
# Välj "Transaction Pooler" (port 6543) för serverless/Node
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-north-1.pooler.supabase.com:6543/postgres

# ─── ALTERNATIV 3: Supabase Lokal Dev (supabase CLI) ───────
# Kör: supabase start → ger en lokal instans
# DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ─── APPLIKATION ────────────────────────────────────────────
NODE_ENV=development
PORT=8787
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── AUTENTISERING ──────────────────────────────────────────
JWT_ACCESS_SECRET=din-hemliga-nyckel-ACCESS-byt-mig!
JWT_REFRESH_SECRET=din-hemliga-nyckel-REFRESH-byt-mig!

# ─── AI-TJÄNSTER ────────────────────────────────────────────
GEMINI_API_KEY=
OPENAI_API_KEY=

# ─── EMBEDDING ──────────────────────────────────────────────
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_FALLBACK_MODELS=text-embedding-004

# ─── LANTMÄTERIET ───────────────────────────────────────────
LANTMATERIET_BASE_URL=https://api.lantmateriet.se
LANTMATERIET_OPEN_MODE=false
# LANTMATERIET_API_KEY=

# ─── EXTERNA API:ER ─────────────────────────────────────────
SLU_API_BASE_URL=https://api.artdatabanken.se
SLU_API_KEY=
# SMHI_BASE_URL=https://opendata-download-metobs.smhi.se

# ─── ADMIN-KONSOL ───────────────────────────────────────────
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD=byt-detta-loesenord!
ADMIN_ORG_NAME=Miljobeslut Dev Org
ADMIN_ORG_NUMBER=556677-8899

# ─── SÖKTJÄNST ──────────────────────────────────────────────
SEARCH_WORKER_ENABLED=true
SEARCH_WORKER_POLL_MS=2500
SEARCH_WORKER_MAX_JOBS=3
SEARCH_DRAFT_WATERMARK=Miljöbeslut.se - GRANSKAD PRODUKTIONSDATA

# ─── LOGISTIK ───────────────────────────────────────────────
LOGISTICS_EMISSION_FACTOR=0.12
LOGISTICS_BASE_RATE=2.4
LOGISTICS_HAZARDOUS_SURCHARGE=1800
LOGISTICS_DEFAULT_DISTANCE=15
LOGISTICS_AVERAGE_SPEED=60

# ─── DISPATCH ───────────────────────────────────────────────
# DISPATCH_PROVIDER_MODE=MOCK_FRAKTBORS
# TIMOCOM_API_KEY=
# TRANS_EU_CLIENT_ID=
# TRANS_EU_CLIENT_SECRET=
