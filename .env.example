# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── AI / LLM ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
# Alias used by Vite frontend (same key, exposed via import.meta.env)
VITE_GEMINI_API_KEY=
OPENAI_API_KEY=
GEMINI_DB_API_KEY=
GEMINI_DB_ALLOW_REMOTE=false
MVP_GEMINI_REQUIREMENTS_MODEL=gemini-2.5-flash
MVP_GEMINI_PERMIT_MODEL=gemini-2.5-pro
MVP_OPENAI_VERIFICATION_MODEL=gpt-4.1-mini
# OCR-modell för gemini-baserad PDF-tolkning (valfritt, faller tillbaka på GEMINI_OCR_MODEL)
OCR_MODEL=
OCR_ENDPOINT=
OCR_API_KEY=

# ── Figma ─────────────────────────────────────────────────────────────────────
FIGMA_TOKEN=
FIGMA_FILE_ID=
FIGMA_MAKE_URL=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Används av orgInvitationService för inbjudningstokens
JWT_SECRET=

# ── Lantmäteriet API ─────────────────────────────────────────────────────────
# Välj ETT autentiseringsalternativ:
#   Alt 1 — OAuth2 Consumer (rekommenderas)
LANTMATERIET_CONSUMER_KEY=
LANTMATERIET_CONSUMER_SECRET=
LANTMATERIET_TOKEN_URL=https://apimanager.lantmateriet.se/oauth2/token
LANTMATERIET_SCOPE=
#   Alt 2 — Kortlivad direkttoken från dev-portalen (GET TEST KEY)
LANTMATERIET_ACCESS_TOKEN=
#   Alt 3 — Legacy API-nyckel
LANTMATERIET_API_KEY=
# Öppet kartläge utan autentisering (true = ingen nyckel krävs)
LANTMATERIET_OPEN_MODE=false
LANTMATERIET_OPEN_SUBSCRIPTION_KEY=
LANTMATERIET_OPEN_WMS_URL=https://minkarta.lantmateriet.se/map/topowebb/?
# Lookup mode: "legacy" (distribution/produkter...) or "ogc" (recommended for fastighetsindelning)
LANTMATERIET_LOOKUP_MODE=ogc
# OGC base URL + collection för fastighetsuppslag by etikett
LANTMATERIET_BASE_URL=https://api.lantmateriet.se/ogc-features/v1
LANTMATERIET_OGC_COLLECTION=registerenhetsomradesytor
# Valfri explicit lookup-endpoint när LANTMATERIET_LOOKUP_MODE=legacy
LANTMATERIET_LOOKUP_ENDPOINT=

# ── BankID RP API v6 (valfritt — kräver fysiskt PFX/PEM-certifikat) ──────────
# BANKID_BASE_URL=https://appapi2.bankid.com/rp/v6.0
# BANKID_PFX_PATH=
# BANKID_PFX_PASSPHRASE=
# # Alternative PEM setup instead of PFX:
# BANKID_CERT_PATH=
# BANKID_KEY_PATH=
# BANKID_CA_PATH=

# SLU Artdatabanken API
SLU_API_BASE_URL=https://api.artdatabanken.se
SLU_API_KEY=
SLU_SPECIES_OBS_API_KEY=
SLU_TAXONOMY_API_KEY=
SLU_ARTFAKTA_API_KEY=
SLU_METODKATALOG_API_KEY=
SLU_SPECIES_OBS_BASE_PATH=/species-observation-system/v1/Observations/Search
SLU_TAXONOMY_BASE_PATH=/taxonlistservice/v1
SLU_ARTFAKTA_BASE_PATH=/information/v1/speciesdataservice/v1
SLU_METODKATALOG_BASE_PATH=/metodkatalog/v1

# ── Prisma / Databas ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://riskguard:password@localhost:5432/riskguard
CORS_ALLOW_ORIGINS=http://localhost:5173,https://www.figma.com

# ── SGU (Geologiska undersökningen) ──────────────────────────────────────────
# "sample" = exempeldata, "complete" = full databas (kräver nedladdning)
SGU_DB_COVERAGE_MODE=sample

# ── Geodata / Terrän ──────────────────────────────────────────────────────────
# Extern höjddata-API (valfritt, syntetisk terräng används om den saknas)
TERRAIN_ENDPOINT=
# Land-Use / Land-Cover endpoint (valfritt)
LULC_ENDPOINT=

# ── Sök / Indexering ─────────────────────────────────────────────────────────
OUTLOOK_BASE_DIR=
OUTLOOK_MANIFEST_PATH=
OUTLOOK_FOLDER_PATH=
OUTLOOK_STORAGE_ROOT=
OUTLOOK_INGEST_INTERVAL_MS=60000
OUTLOOK_WEBHOOK_SECRET=
LOCAL_DB_ROOT=
MUNICIPAL_CONTACTS_CSV_PATH=
MUNICIPAL_DIARIES_INDEX_URL=
SEARCH_ENCRYPTION_KEY_BASE64=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_FALLBACK_MODELS=gemini-embedding-001,text-embedding-004
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_MS=25000
GEMINI_OCR_MODEL=gemini-2.5-flash
SEARCH_OCR_MIN_TEXT_CHARS=120
SEARCH_OCR_MAX_FILE_BYTES=12000000
SEARCH_WORKER_ENABLED=true
SEARCH_WORKER_POLL_MS=2500
SEARCH_WORKER_MAX_JOBS=3
SEARCH_JOB_MAX_ATTEMPTS=3
SEARCH_JOB_STALE_MINUTES=30
SEARCH_JOB_STALE_RECOVERY_LIMIT=200
SEARCH_JOB_RECOVERY_INTERVAL_MS=120000

# ── Tillståndsmyndigheter (myndighets-API) ────────────────────────────────────
# Endpoint för elektronisk ärendeinlämning (valfritt, mock-läge annars)
AUTHORITY_SUBMIT_ENDPOINT=
AUTHORITY_API_KEY=

# ── eIDAS QTSP-signatur ────────────────────────────────────────────────────────
# Qualified Trust Service Provider för kvalificerad e-signatur (valfritt)
EIDAS_QTSP_ENDPOINT=
EIDAS_QTSP_API_KEY=

# ── LIMS (Laboratoriedata) ────────────────────────────────────────────────────
# Automatisk hämtning av provresultat (valfritt)
LIMS_API_ENDPOINT=
LIMS_API_KEY=

# ── Marknadsdata / Logistik ────────────────────────────────────────────────────
# Extern pristabell-API (valfritt, statiska baspriser används annars)
MARKET_INTEL_ENDPOINT=

# ── Monitorering / Felspårning ────────────────────────────────────────────────
# Sentry DSN för produktion (valfritt, lokal ring-buffer används annars)
SENTRY_DSN=
# Bearer-token för /metrics-endpoint (valfritt, öppen om den saknas)
METRICS_BEARER_TOKEN=

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_DIR=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=backups/

# ── Admin console ────────────────────────────────────────────────────────────
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD=
ADMIN_ORG_NAME=Miljobeslut Admin
ADMIN_ORG_NUMBER=999999-0001

# Dispatch provider feature flag
# Allowed values: MOCK_FRAKTBORS | TIMOCOM | TRANS_EU
DISPATCH_PROVIDER_MODE=MOCK_FRAKTBORS
# Optional credentials for external adapters (mock fallback if missing)
TIMOCOM_API_KEY=
TRANS_EU_API_KEY=

# Trafikverket API
TRAFIKVERKET_API_KEY=
TRAFIKVERKET_API_BASE_URL=https://api.trafikinfo.trafikverket.se/v2/data.json

# VISS WFS / vattenforekomster
# Importscriptet anvander explicit api key och har ingen anonym fallback.
VISS_API_KEY=
VISS_API_BASE_URL=https://viss.lansstyrelsen.se/api
VISS_WFS_URL=https://ext-geodata.lansstyrelsen.se/viss/wfs
VISS_LAYER_NAME=ms:viss_vattendirektivet_ytvatten
VISS_TIMEOUT_SECONDS=180

# ── Databas-statistik tröskelvärden (valfritt, standardvärden används annars)
# Kravrader ≥ 41 000, kommuner ≥ 260, dokument ≥ 3 000
DB_STATS_MIN_REQUIREMENTS=41000
DB_STATS_MIN_MUNICIPALITIES=260
DB_STATS_MIN_DOCUMENTS=3000

# ── E-postaviseringar (valfritt) ──────────────────────────────────────────────
# Om SMTP_HOST, SMTP_USER och SMTP_PASS är satta skickas notiser via e-post.
# Lämnas tomma loggas notiser endast i AuditTrail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=noreply@miljobeslut.se
