# Compose-variabler (docker compose läser .env i projektroten)
# Kopiera till .env om du vill override defaults i docker-compose.prod.yml
#
#   Copy-Item .env.compose.example .env

# Runtime metadata
BUILD_SHA=
POSTGRES_PASSWORD=
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Provider-neutral runtime configuration. Keep secrets out of the repository.
LANTMATERIET_BASE_URL=https://api.lantmateriet.se/ogc-features/v1
LANTMATERIET_OPEN_MODE=false
LANTMATERIET_CONSUMER_KEY=
LANTMATERIET_CONSUMER_SECRET=
LANTMATERIET_ACCESS_TOKEN=
LANTMATERIET_API_KEY=
VERTEX_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
GEMINI_API_KEY=

# Master/source archive (authority C) — read-only bind mount.
MASTER_ARCHIVE_HOST_PATH=H:/Delade enheter/Miljöbeslut/GEO_Master_Archive

# Worker-only LU signer key files. Values are host paths outside the repository.
PROJECT_CONTEXT_BINDING_ISSUER_PRIVATE_KEY_FILE=
LU_EXECUTION_AUTHORITY_PRIVATE_KEY_FILE=
VIEWER_CAPABILITY_ISSUER_PRIVATE_KEY_FILE=
LOCALIZATION_GEOMETRY_SUPERSESSION_ISSUER_PRIVATE_KEY_FILE=
