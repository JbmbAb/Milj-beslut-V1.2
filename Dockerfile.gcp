# Dockerfile.gcp — produktionsimage för Google Cloud Run.
#
# Skillnader mot Dockerfile.fly:
#  - Lyssnar på $PORT som Cloud Run injicerar (default 8080).
#  - Kör Cloud SQL via privat IP (Serverless VPC Connector) — ingen proxy
#    behöver installeras i image.
#  - Vertex AI auth sker via metadataservern — inga nyckelfiler i bilden.
#
# Byggs via `gcloud builds submit --config cloudbuild.yaml` eller direkt
# via `docker build -f Dockerfile.gcp -t gcr.io/PROJECT/miljobeslut:latest .`

FROM node:22-alpine AS base
RUN apk update && apk add --no-cache openssl curl tini
WORKDIR /app

# ─── Build stage ──────────────────────────────────────────────────────────────
FROM base AS builder

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./

ENV DATABASE_URL=postgresql://localhost:5432/docker_build_dummy

RUN npm ci --legacy-peer-deps --no-audit --prefer-offline --ignore-scripts

RUN npx prisma generate

COPY . .

# Vite-build → dist/
RUN npm run build

# ─── Production stage ─────────────────────────────────────────────────────────
FROM base AS production

ENV NODE_ENV=production
ENV PORT=8080

RUN addgroup -S appgroup && adduser -S appuser -G appgroup

COPY package*.json ./
COPY tsconfig.json ./
COPY prisma ./prisma
COPY prisma.config.ts ./

ENV DATABASE_URL=postgresql://localhost:5432/docker_build_dummy

RUN npm ci --omit=dev --legacy-peer-deps --no-audit --prefer-offline --ignore-scripts \
  && npm install --no-save tsx@4 \
  && npm cache clean --force

RUN npx prisma generate

COPY --from=builder /app/server ./server
COPY --from=builder /app/src ./src
COPY --from=builder /app/services ./services
COPY --from=builder /app/types.ts ./types.ts
COPY --from=builder /app/db.server.ts ./db.server.ts
COPY --from=builder /app/constants.ts ./constants.ts
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/scripts ./scripts

RUN chown -R appuser:appgroup /app
USER appuser

EXPOSE 8080

# Cloud Run har egen healthcheck — men vi anger tini som PID1 för korrekt
# signal-hantering vid scale-down.
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "--import", "tsx", "server/index.ts"]
