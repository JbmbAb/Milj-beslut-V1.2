# ─────────────────────────────────────────────────────────────────────────────
# .env.production.gcp.example
#
# Mall för Google Cloud-driftsättning.
# Kopiera till .env.production och fyll i riktiga värden.
# Ladda upp hemligheter till Secret Manager – se deploy/gcp/README.md.
#
# Variabler markerade SECRET nedan läggs i Secret Manager, inte i Cloud Run env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Databas (Cloud SQL for PostgreSQL via Unix-socket) ────────────────────────
# SECRET – lägg i Secret Manager som "DATABASE_URL"
# Ersätt <PROJECT_ID> med ditt GCP-projekt-ID och sätt rätt lösenord.
# Cloud Run monterar socket automatiskt via --add-cloudsql-instances.
DATABASE_URL=postgresql://miljobeslut:<LÖSENORD>@localhost/miljobeslut_prod?host=/cloudsql/<PROJECT_ID>:europe-west1:miljobeslut-db

# ── JWT ───────────────────────────────────────────────────────────────────────
# SECRET – generera med: openssl rand -hex 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── AI-modeller ───────────────────────────────────────────────────────────────
# SECRET
GEMINI_API_KEY=
GEMINI_DB_API_KEY=
GEMINI_DB_ALLOW_REMOTE=false
OPENAI_API_KEY=
MVP_GEMINI_REQUIREMENTS_MODEL=gemini-2.5-flash
MVP_GEMINI_PERMIT_MODEL=gemini-2.5-pro
MVP_OPENAI_VERIFICATION_MODEL=gpt-4.1-mini

# ── Figma (valfritt, används ej i prod) ───────────────────────────────────────
FIGMA_TOKEN=
FIGMA_FILE_ID=
FIGMA_MAKE_URL=

# ── Lantmäteriet API ──────────────────────────────────────────────────────────
# SECRET
LANTMATERIET_API_KEY=
LANTMATERIET_TOKEN_URL=https://apimanager.lantmateriet.se/oauth2/token
LANTMATERIET_CONSUMER_KEY=sNRTGMemeL0ZOH0znI4E0vCnqd0a
LANTMATERIET_CONSUMER_SECRET=Ybnhw86PkD2kQetlqlQxwCqP2nUa
LANTMATERIET_ACCESS_TOKEN=curl -k -X POST https://apimanager.lantmateriet.se/oauth2/token -d "grant_type=client_credentials" -H "Authorization: Basic c05SVEdNZW1lTDBaT0gwem5JNEUwdkNucWQwYTpZYm5odzg2UGtEMmtRZXRscWxReHdDcVAyblVh"
LANTMATERIET_LOOKUP_MODE=ogc
LANTMATERIET_BASE_URL=https://api.lantmateriet.se/ogc-features/v1
LANTMATERIET_OGC_COLLECTION=registerenhetsomradesytor
LANTMATERIET_LOOKUP_ENDPOINT=

# ── BankID RP API (aktivera först när avtal + certifikat finns) ──────────────
# Före avtal: lämna BankID oaktiverat i kundnära miljö och använd admininloggning.
# Testmiljö använder separat endpoint + separat testcertifikat.
# Produktion använder produktionsendpoint först efter verifierad testmiljö.
# SECRET – PFX/PEM och lösenord lagras i Secret Manager.
# BANKID_BASE_URL=
# BANKID_PFX_PATH=/secrets/bankid/bankid.pfx
# BANKID_PFX_PASSPHRASE=
# BANKID_CERT_PATH=
# BANKID_KEY_PATH=
# BANKID_CA_PATH=

# ── SLU Artdatabanken ─────────────────────────────────────────────────────────
# SECRET
SLU_API_BASE_URL=https://api.artdatabanken.se
SLU_API_KEY=
SLU_SPECIES_OBS_API_KEY=
SLU_TAXONOMY_API_KEY=3557d44652714675848836aa853755fd
SLU_ARTFAKTA_API_KEY=1560f2c292ca49778510af6b2a0da957
SLU_ARTDATA_METOD_KEY=afc7ae9f98c6452796dfa73afa7717f9
SLU_METODKATALOG_API_KEY=a970769fee964bda8064b72235841396
SLU_SPECIES_OBS_BASE_PATH=/species-observation-system/v1/Observations/Search
SLU_TAXONOMY_BASE_PATH=/taxonlistservice/v1
SLU_ARTFAKTA_BASE_PATH=/information/v1/speciesdataservice/v1
SLU_METODKATALOG_BASE_PATH=/metodkatalog/v1

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOW_ORIGINS=https://miljobeslut.se

# ── Sökning och indexering ────────────────────────────────────────────────────
# SECRET – krypteringsnyckel för sök-index
SEARCH_ENCRYPTION_KEY_BASE64=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_FALLBACK_MODELS=gemini-embedding-001,text-embedding-004
EMBEDDING_DIM=768
EMBEDDING_TIMEOUT_MS=25000
GEMINI_OCR_MODEL=gemini-2.5-flash
SEARCH_OCR_MIN_TEXT_CHARS=120
SEARCH_OCR_MAX_FILE_BYTES=12000000
SEARCH_WORKER_ENABLED=true
SEARCH_WORKER_POLL_MS=2500
SEARCH_WORKER_MAX_JOBS=3
SEARCH_JOB_MAX_ATTEMPTS=3
SEARCH_JOB_STALE_MINUTES=30
SEARCH_JOB_STALE_RECOVERY_LIMIT=200
SEARCH_JOB_RECOVERY_INTERVAL_MS=120000

# ── Adminkonsolens inloggning ─────────────────────────────────────────────────
# SECRET – ADMIN_CONSOLE_PASSWORD läggs i Secret Manager
ADMIN_CONSOLE_USERNAME=admin
ADMIN_CONSOLE_PASSWORD=Rovev
ADMIN_ORG_NAME=Mimer Miljöintelligens AB
ADMIN_ORG_NUMBER=559584-0389

# ── Transportdispatch ─────────────────────────────────────────────────────────
DISPATCH_PROVIDER_MODE=MOCK_FRAKTBORS
TIMOCOM_API_KEY=
TRANS_EU_API_KEY=

