{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miljobeslut.local/schema/control-plane/lease-v1.schema.json",
  "title": "Multi-Agent Control Plane Lease V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "lease_id",
    "unit_id",
    "role",
    "holder",
    "scope",
    "issued_at",
    "expires_at",
    "heartbeat_at",
    "status"
  ],
  "properties": {
    "schema_version": { "const": "multi-agent-lease-v1" },
    "lease_id": { "type": "string", "minLength": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "role": { "enum": ["IMPLEMENTER", "VERIFIER"] },
    "holder": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "candidate_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "heartbeat_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ACTIVE", "RELEASED", "EXPIRED", "REVOKED"] }
  }
}
