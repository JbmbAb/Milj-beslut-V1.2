{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miljobeslut.local/schema/control-plane/agent-handoff-v1.schema.json",
  "title": "Multi-Agent Control Plane Handoff V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "agent_run_id",
    "unit_id",
    "role",
    "input_state",
    "observed_base_sha",
    "result",
    "findings",
    "output_artifacts",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "schema_version": { "const": "multi-agent-handoff-v1" },
    "agent_run_id": { "type": "string", "minLength": 1 },
    "unit_id": { "type": "string", "minLength": 1 },
    "role": {
      "enum": ["IMPLEMENTER", "VERIFIER", "CONTROLLER", "SIGNER", "GATE", "PROMOTER"]
    },
    "input_state": { "type": "string", "minLength": 1 },
    "observed_base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "observed_candidate_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "unit_definition_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "proof_contract_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED_ENVIRONMENT",
        "BLOCKED_DESIGN",
        "BLOCKED_DEPENDENCY",
        "DENIED_GOVERNANCE",
        "CANCELLED"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "classification", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["BLOCKING", "NON_BLOCKING"] },
          "classification": { "enum": ["SEMANTIC", "MECHANICAL", "ENVIRONMENT", "AUTHORITY", "DEPENDENCY", "OTHER"] },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "requested_next_action": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" }
  }
}
