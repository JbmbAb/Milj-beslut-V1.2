{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miljobeslut.local/schema/control-plane/unit-state-v1.schema.json",
  "title": "Multi-Agent Control Plane Unit State V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "unit_id",
    "unit_definition_hash",
    "base_sha",
    "branch",
    "scope",
    "state",
    "controller_contract_version",
    "revision",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "multi-agent-unit-state-v1" },
    "unit_id": { "type": "string", "minLength": 1 },
    "unit_definition_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidate_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "branch": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "proof_contract_hash": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "controller_contract_version": { "const": "multi-agent-control-plane-v1" },
    "state": {
      "enum": [
        "PLANNED",
        "IMPLEMENTING",
        "IMPLEMENTATION_READY",
        "VERIFYING",
        "VERIFY_FAILED",
        "READY_FOR_DEV_GOV",
        "PROVING_RED",
        "PROVING_GREEN",
        "GATING",
        "GATE_FAILED",
        "GATE_PASSED",
        "PROMOTING",
        "PROMOTION_FAILED",
        "PROMOTED",
        "CLOSED",
        "BLOCKED_ENVIRONMENT",
        "BLOCKED_DESIGN",
        "BLOCKED_DEPENDENCY",
        "CANCELLED",
        "SUPERSEDED"
      ]
    },
    "active_lineage_id": { "type": ["string", "null"], "minLength": 1 },
    "supersedes_candidate_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
