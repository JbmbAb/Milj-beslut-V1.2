{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mimer.miljobeslut.se/schemas/governance/semantic-absence-falsification-v1.json",
  "title": "Semantic Absence Falsification Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "status",
    "purpose",
    "default_disposition",
    "allowed_dispositions",
    "normative_rules",
    "stop_questions",
    "decision_requirements"
  ],
  "properties": {
    "schema_version": {
      "const": "semantic-absence-falsification-v1"
    },
    "policy_id": {
      "const": "SEMANTIC-ABSENCE-FALSIFICATION-01"
    },
    "status": {
      "enum": ["ACTIVE", "RETIRED"]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "default_disposition": {
      "const": "UNRESOLVED"
    },
    "allowed_dispositions": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "UNRESOLVED",
          "DERIVABLE",
          "SEMANTIC_DUPLICATE",
          "MECHANISM_ONLY",
          "WRONG_ABSTRACTION_LEVEL",
          "IRREDUCIBLE_SEMANTIC",
          "BLOCKED_BY_PRECONDITION"
        ]
      },
      "allOf": [
        {
          "contains": { "const": "UNRESOLVED" }
        },
        {
          "contains": { "const": "DERIVABLE" }
        },
        {
          "contains": { "const": "SEMANTIC_DUPLICATE" }
        },
        {
          "contains": { "const": "MECHANISM_ONLY" }
        },
        {
          "contains": { "const": "WRONG_ABSTRACTION_LEVEL" }
        },
        {
          "contains": { "const": "IRREDUCIBLE_SEMANTIC" }
        },
        {
          "contains": { "const": "BLOCKED_BY_PRECONDITION" }
        }
      ]
    },
    "normative_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stop_questions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question"],
        "properties": {
          "id": {
            "enum": ["SA-1", "SA-2", "SA-3", "SA-4", "SA-5", "SA-6"]
          },
          "question": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_evidence",
        "forbid_predetermined_outcome",
        "require_explicit_unresolved_state"
      ],
      "properties": {
        "required_evidence": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "repository_paths",
              "existing_semantics_examined",
              "falsification_argument",
              "known_counterexamples",
              "preconditions"
            ]
          }
        },
        "forbid_predetermined_outcome": {
          "const": true
        },
        "require_explicit_unresolved_state": {
          "const": true
        }
      }
    }
  }
}
