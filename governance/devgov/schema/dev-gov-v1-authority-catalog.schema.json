{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miljobeslut.local/schemas/dev-gov-v1-authority-catalog.schema.json",
  "title": "DEV-GOV-V1 Protected Authority Catalog",
  "description": "Verifier-controlled binding from an authority capability id to a concrete content identity, retrieval source and materialization contract. This document lives on the protected default branch and is read only from the controller checkout; a candidate copy of this path is never consulted.",
  "type": "object",
  "required": ["schema_version", "authorities"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "dev-gov-v1-authority-catalog" },
    "authorities": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z0-9][A-Z0-9-]{2,63}$" },
      "additionalProperties": { "$ref": "#/$defs/authority" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "authority": {
      "type": "object",
      "required": ["provider", "source", "archive", "content", "capability_env"],
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "provider": { "enum": ["github-release-asset"] },
        "source": {
          "type": "object",
          "required": ["repository", "release_tag", "asset_name"],
          "additionalProperties": false,
          "properties": {
            "repository": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
            "release_tag": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
            "asset_name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
          }
        },
        "archive": {
          "type": "object",
          "required": ["format", "sha256"],
          "additionalProperties": false,
          "properties": {
            "format": { "const": "tar.gz" },
            "sha256": {
              "$ref": "#/$defs/sha256",
              "description": "Digest of the retrieved archive bytes, checked before anything is expanded."
            }
          }
        },
        "content": {
          "type": "object",
          "required": ["digest_algorithm", "digest"],
          "additionalProperties": false,
          "properties": {
            "digest_algorithm": { "const": "dev-gov-authority-tree-sha256-v1" },
            "digest": {
              "$ref": "#/$defs/sha256",
              "description": "Canonical digest of the expanded tree: sha256 over the stable JSON encoding of [posixRelativePath, sha256(fileBytes)] pairs sorted by path. Symlinks and non-regular entries are rejected, not skipped."
            }
          }
        },
        "reference": {
          "type": "object",
          "description": "Optional externally bound reference identity carried inside the materialization.",
          "required": ["digest_algorithm", "digest", "entry"],
          "additionalProperties": false,
          "properties": {
            "digest_algorithm": { "const": "sha256" },
            "digest": { "$ref": "#/$defs/sha256" },
            "entry": { "type": "string", "minLength": 1 }
          }
        },
        "capability_env": {
          "type": "object",
          "description": "Environment names the verified materialization is exposed to the proof process under. Chosen by protected configuration, never by the candidate.",
          "required": ["root"],
          "additionalProperties": false,
          "properties": {
            "root": { "$ref": "#/$defs/envName" },
            "reference": { "$ref": "#/$defs/envName" }
          }
        },
        "required_entries": {
          "type": "array",
          "description": "Paths that must exist in the materialization before the content digest is accepted.",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
