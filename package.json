{
  "name": "miljobeslut-se-2.0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node --import tsx server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \".github/**/*.{md,yml,yaml}\" \"docs/qa/**/*.md\" \"tests/**/*.{ts,tsx}\" \"server/createApp.ts\" \"server/index.ts\" \"scripts/db/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.ts\" \"playwright.config.ts\" \".prettierrc.json\" \"package.json\" --write",
    "format:check": "prettier \".github/**/*.{md,yml,yaml}\" \"docs/qa/**/*.md\" \"tests/**/*.{ts,tsx}\" \"server/createApp.ts\" \"server/index.ts\" \"scripts/db/**/*.ts\" \"eslint.config.mjs\" \"vitest.config.ts\" \"playwright.config.ts\" \".prettierrc.json\" \"package.json\" --check",
    "test:unit": "vitest run --config vitest.config.ts --project unit --coverage",
    "test:integration": "npm run db:test:migrate && npm run db:test:seed && vitest run --config vitest.config.ts --project integration",
    "test:e2e": "npm run db:test:migrate && npm run db:test:seed && playwright test",
    "test": "npm run test:unit && npm run test:integration",
    "qa": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "qa:full": "npm run qa && npm run build && npm run test:e2e",
    "db:test:migrate": "dotenv -e .env.test -- prisma migrate deploy",
    "db:test:seed": "dotenv -e .env.test -- tsx scripts/db/seed-test.ts",
    "db:test:reset": "dotenv -e .env.test -- prisma migrate reset --force --skip-seed",
    "figma:export": "tsx scripts/export-figma.ts",
    "kravmatris:auto": "tsx scripts/export-kravmatris-from-dump.ts",
    "requirements:model": "tsx scripts/build-requirements-model.ts",
    "search:health": "tsx scripts/search-health.ts",
    "search:repair": "tsx scripts/search-health.ts --repair --recover-stale",
    "tokens:build": "node scripts/build-tokens-css.mjs",
    "preview": "vite preview",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@google/genai": "^1.41.0",
    "@google/generative-ai": "^0.24.1",
    "@loaders.gl/core": "^4.1.0",
    "@loaders.gl/las": "^4.1.0",
    "@loaders.gl/ply": "^4.1.0",
    "@prisma/client": "^6.5.0",
    "@remix-run/node": "^2.16.0",
    "body-parser": "^2.2.0",
    "clsx": "^2.1.1",
    "docx": "^9.6.0",
    "express": "^5.1.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.575.0",
    "motion": "^12.34.3",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.5.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.1",
    "prisma": "^6.5.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.56.1",
    "vite": "^6.2.0",
    "vitest": "^4.0.18"
  }
}
